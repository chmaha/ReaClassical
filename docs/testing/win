$ErrorActionPreference = "Stop"

# Force TLS 1.2 explicitly - older/enterprise Windows images (e.g. Win10
# LTSC) don't always default Invoke-WebRequest/.NET to a protocol GitHub
# actually accepts, and the failure can be intermittent per-request rather
# than blanket (some downloads succeed, a later one to the same domain
# family fails) - a real report this session matched exactly that pattern.
# Harmless to force unconditionally even where TLS 1.2 already works.
[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12

# Version
$rcver = "testing"
$branch = "testing"
$tempDir = $null

# ------------------------
# Cleanup function
# ------------------------
function Cleanup {
    if ($tempDir -and (Test-Path $tempDir)) {
        Remove-Item -Path $tempDir -Recurse -Force -ErrorAction SilentlyContinue
    }
}

# Cleanup trap
trap {
    Cleanup
    Write-Host "`nInstallation failed or cancelled. Temporary files removed."
    break
}

# ------------------------
# Retry wrapper
# ------------------------
# Invoke-WebRequest/Invoke-RestMethod have no native --retry flag (unlike
# curl, used by docs/macos and docs/linux) - a real tester hit curl exit 56
# (CURLE_RECV_ERROR) on macOS right after a fresh publish, most likely
# GitHub's CDN not having fully propagated the new release yet. Same class
# of transient failure can happen here, so wrap every download/API call in
# a small manual retry loop instead.
function Invoke-WithRetry {
    param(
        [Parameter(Mandatory = $true)][scriptblock]$Action,
        [int]$MaxAttempts = 3,
        [int]$DelaySeconds = 2
    )
    for ($attempt = 1; $attempt -le $MaxAttempts; $attempt++) {
        try {
            return & $Action
        } catch {
            if ($attempt -eq $MaxAttempts) { throw }
            Start-Sleep -Seconds $DelaySeconds
        }
    }
}

# ------------------------
# Internet check
# ------------------------
function Check-Internet {
    try {
        if (-not (Test-Connection -ComputerName 8.8.8.8 -Count 1 -Quiet)) { throw }
    } catch {
        Write-Host "`nError: Installer requires an internet connection."
        Write-Host "Exiting..."
        exit 1
    }
}

Write-Host "`n*** TESTING BUILD - this installs an in-development, pre-release"
Write-Host "*** version of ReaClassical (currently tracking the $branch branch), not the"
Write-Host "*** publicly released version. Expect bugs. ***`n"
Start-Sleep -Seconds 2

# ------------------------
# Detect Architecture
# ------------------------
$systemArch = $env:PROCESSOR_ARCHITECTURE
switch ($systemArch) {
    "AMD64" { $arch = "x64" }
    "ARM64" { $arch = "arm64ec" }
    "x86"   { $arch = "x86" }
    default {
        Write-Host "Unknown architecture: $systemArch"
        exit 1
    }
}

# ------------------------
# Ask user where to install
# ------------------------
Add-Type -AssemblyName System.Windows.Forms
$dialog = New-Object System.Windows.Forms.FolderBrowserDialog
$dialog.Description = "Choose where to install ReaClassical (TESTING BUILD). A new folder named ReaClassical_$rcver will be created here."
$dialog.ShowNewFolderButton = $true

if ($dialog.ShowDialog() -ne "OK") {
    Write-Host "Installation cancelled by user."
    return
}

$userSelectedPath = $dialog.SelectedPath

# ------------------------
# Determine final folder with random suffix if needed
# ------------------------
function Get-RandomAlphaNum($length = 5) {
    $chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789'
    -join ((1..$length) | ForEach-Object { $chars[(Get-Random -Minimum 0 -Maximum $chars.Length)] })
}

$finalInstallPath = Join-Path $userSelectedPath "ReaClassical_$rcver"
$suffixApplied = $false

while (Test-Path $finalInstallPath) {
    $suffix = "_" + (Get-RandomAlphaNum 5)
    $finalInstallPath = Join-Path $userSelectedPath "ReaClassical_$rcver$suffix"
    $suffixApplied = $true
}

if ($suffixApplied) {
    Write-Host "Folder 'ReaClassical_$rcver' already exists. Using unique suffix..."
}

Write-Host "`nSelected install location: $finalInstallPath`n"
Start-Sleep -Seconds 1

# ------------------------
# Check internet after location
# ------------------------
Check-Internet

# ------------------------
# Get tested REAPER version
# ------------------------
$verTxt = "https://raw.githubusercontent.com/chmaha/ReaClassical/$branch/tested_reaper_ver.txt"
$verContent = Invoke-WithRetry -Action { Invoke-WebRequest -Uri $verTxt -UseBasicParsing | Select-Object -ExpandProperty Content }
$ver = ($verContent -split "`n" | Select-String -Pattern "====" -Context 0,1).Context.PostContext[0].Trim()
$major = $ver.Split('.')[0]
$minor = $ver.Split('.')[1]

# ------------------------
# Create TEMP workspace
# ------------------------
$tempDir = [System.IO.Path]::Combine($env:TEMP, [System.IO.Path]::GetRandomFileName())
New-Item -Path $tempDir -ItemType Directory -Force | Out-Null

$tempInstallRoot = Join-Path $tempDir "ReaClassical_$rcver"
New-Item -Path $tempInstallRoot -ItemType Directory -Force | Out-Null

Write-Host "Building ReaClassical in temporary workspace..."
Start-Sleep -Seconds 1

# ------------------------
# Download REAPER installer
# ------------------------
Write-Host "Downloading REAPER $ver ($arch)..."
switch ($arch) {
    "x64" {
        $reaperFile = "reaper$major$minor`_x64-install.exe"
        $reaperUrl  = "https://www.reaper.fm/files/$major.x/$reaperFile"
    }
    "arm64ec" {
        $reaperFile = "reaper$major$minor`_win11_arm64ec_beta-install.exe"
        $reaperUrl  = "https://www.reaper.fm/files/$major.x/$reaperFile"
    }
    "x86" {
        $reaperFile = "reaper$major$minor-install.exe"
        $reaperUrl  = "https://www.reaper.fm/files/$major.x/$reaperFile"
    }
}

$reaperOutput = Join-Path $tempDir $reaperFile
Invoke-WithRetry -Action { Invoke-WebRequest -Uri $reaperUrl -OutFile $reaperOutput -UseBasicParsing }

# ------------------------
# Download portable 7zip (architecture-appropriate)
# ------------------------
$sevenZipZip = Join-Path $tempDir "7zip.zip"
$sevenZipPath = Join-Path $tempDir "7zip"

if ($arch -eq "x86") {
    $sevenZipUrl = "https://github.com/chmaha/7-zip/raw/main/7zip32.zip"
} else {
    $sevenZipUrl = "https://github.com/chmaha/7-zip/raw/main/7zip.zip"
}

Invoke-WithRetry -Action { Invoke-WebRequest -Uri $sevenZipUrl -OutFile $sevenZipZip -UseBasicParsing }
Expand-Archive -Path $sevenZipZip -DestinationPath $sevenZipPath -Force

# ------------------------
# Extract REAPER inside TEMP
# ------------------------
Write-Host "Extracting REAPER..."
$reaperExtract = Join-Path $tempDir "reaper_extract"
& "$sevenZipPath\7z.exe" x $reaperOutput "-o$reaperExtract" -y | Out-Null
Get-ChildItem -Path $reaperExtract -Recurse | Move-Item -Destination $tempInstallRoot -Force

# ------------------------
# Download ReaClassical components
# ------------------------
Write-Host "Downloading ReaClassical components..."
$resOutput = Join-Path $tempDir "Resource_Folder_Base.zip"
$upOutput  = Join-Path $tempDir "UP_Windows-$arch.zip"

Invoke-WithRetry -Action { Invoke-WebRequest -Uri "https://github.com/chmaha/ReaClassical/raw/$branch/Installers/Resource_Folder_Base.zip" -OutFile $resOutput -UseBasicParsing }
Invoke-WithRetry -Action { Invoke-WebRequest -Uri "https://github.com/chmaha/ReaClassical/raw/$branch/Installers/UserPlugins/UP_Windows-$arch.zip" -OutFile $upOutput -UseBasicParsing }

Expand-Archive -Path $resOutput -DestinationPath $tempInstallRoot -Force
Expand-Archive -Path $upOutput  -DestinationPath (Join-Path $tempInstallRoot "UserPlugins") -Force

# ------------------------
# Copy Effects from InstallData
# ------------------------
Write-Host "Copying Effects from InstallData..."
$installDataPath = Join-Path $tempInstallRoot "`$INSTDIR`$_8_"
$installDataEffects = Join-Path $installDataPath "Effects"
if (Test-Path $installDataEffects) {
    $effectsFolder = Join-Path $tempInstallRoot "Effects"
    New-Item -Path $effectsFolder -ItemType Directory -Force | Out-Null
    Copy-Item -Path "$installDataEffects\*" -Destination $effectsFolder -Recurse -Force -ErrorAction SilentlyContinue
    Write-Host "Removing InstallData folder..."
    Remove-Item -Path $installDataPath -Recurse -Force -ErrorAction SilentlyContinue
} else {
    Write-Host "Warning: InstallData\Effects directory not found"
}

# ------------------------
# MOVE final install to user-selected destination BEFORE patching reaper.ini,
# so the saved absolute theme path points at the real install location
# rather than the temp workdir.
# ------------------------
Write-Host "`nFinalizing installation..."
Move-Item -Path $tempInstallRoot -Destination $finalInstallPath -Force

# ------------------------
# Modify reaper.ini
# ------------------------
$iniPath = Join-Path $finalInstallPath "reaper.ini"

# Add theme
$iniContent = Get-Content $iniPath
$newContent = @()
foreach ($line in $iniContent) {
    $newContent += $line
    if ($line -eq "[REAPER]") {
        $newContent += "lastthemefn5=$finalInstallPath\ColorThemes\ReaClassical.ReaperTheme"
    }
}
$newContent | Set-Content $iniPath

# Add splash
$iniContent = Get-Content $iniPath
$newContent = @()
foreach ($line in $iniContent) {
    $newContent += $line
    if ($line -eq "[REAPER]") {
        $newContent += "splashimage=Scripts/chmaha Scripts/ReaClassical/reaclassical-splash.png"
    }
}
$newContent | Set-Content $iniPath

Write-Host "`nReaClassical installation complete (TESTING BUILD)!"
Write-Host "Installed to: $finalInstallPath"

# ------------------------
# Cleanup TEMP
# ------------------------
Cleanup
