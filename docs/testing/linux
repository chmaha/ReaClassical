rcver="testing"
branch="testing"

cleanup() {
    if [ -n "$temp_dir" ] && [ -d "$temp_dir" ]; then
        rm -rf "$temp_dir"
    fi
}

check_internet() {
    if ! ping -c 1 -W 5 8.8.8.8 >/dev/null 2>&1; then
        printf "\nError: The ReaClassical installer requires an internet connection.\n"
        printf "Enable the connection if possible or transfer the portable install from an online machine.\n"
        printf "Exiting...\n\n"
        exit 1
    fi
}

# Trap exit signals to ensure cleanup
trap cleanup EXIT

check_internet

ver_txt="https://raw.githubusercontent.com/chmaha/ReaClassical/${branch}/tested_reaper_ver.txt"
ver=$(curl -sS "$ver_txt" | awk '/====/{getline; print}')

major=$(echo $ver | awk -F. '{print $1}')
minor=$(echo $ver | awk -F. '{print $2}')
arch=$(uname -m)

case "$arch" in
    i686|i386|armv7l)
        printf "\nError: ReaClassical only supports 64-bit systems.\n"
        printf "This machine (%s) is not supported.\n\n" "$arch"
        exit 1
        ;;
esac

printf "\n*** TESTING BUILD - this installs an in-development, pre-release\n"
printf "*** version of ReaClassical (currently tracking the %s branch), not the\n" "$branch"
printf "*** publicly released version. Expect bugs. ***\n\n"
sleep 2
printf "Welcome to the ReaClassical installer...\n\n"
sleep 2

# Ask user where to install
default_install="$HOME/Desktop"
printf "Install location (press Enter for %s): " "$default_install" > /dev/tty
read -r user_input < /dev/tty
install_dir="${user_input:-$default_install}"

# Make sure the directory exists
mkdir -p "$install_dir" || {
    echo "Failed to create installation directory: $install_dir"
    exit 1
}

rcfolder="$install_dir/ReaClassical_$rcver"

printf "Versions: REAPER $ver ($arch), ReaClassical $rcver\n\n"
sleep 2


date_suffix=$(date +%s | sha256sum | cut -c1-5)

# Try to create a temporary directory using mktemp
temp_dir=$(mktemp -d 2>/dev/null)
# Check if mktemp was successful
if [ -z "$temp_dir" ]; then
    # Fallback option: use /tmp as temporary directory
    temp_dir="/tmp/ReaClassical_${date_suffix}"
    mkdir -p "$temp_dir"
fi

echo "Downloading REAPER from reaper.fm..."
sleep 2
reaper_output="$temp_dir/reaper${major}${minor}_linux_${arch}.tar.xz"
reaper_url="https://reaper.fm/files/${major}.x/reaper${major}${minor}_linux_${arch}.tar.xz"
curl -L -o "$reaper_output" --progress-bar "$reaper_url"

# Check if a ReaClassical folder already exists
if [ -d "$rcfolder" ]; then
    # If it exists, create a folder with a date suffix
    rcfolder="${rcfolder}_${date_suffix}"
    sleep 2
    echo "Folder ReaClassical_${rcver} already exists. Adding unique identifier as suffix."
fi
sleep 2
echo "Extracting files from REAPER archive to ${rcfolder} folder"
tar -xf "$reaper_output" -C "$temp_dir"
mv "$temp_dir/reaper_linux_${arch}/" "${rcfolder}/"
mv "${rcfolder}/REAPER/"* "${rcfolder}/"
rmdir "${rcfolder}/REAPER"

echo "Downloading ReaClassical files from Github..."
sleep 2
res_output="$temp_dir/Resource_Folder_Base.zip"
res_url="https://github.com/chmaha/ReaClassical/raw/${branch}/Installers/Resource_Folder_Base.zip"
curl -L -o "$res_output" --progress-bar "$res_url"
sleep 2
unzip -q "$temp_dir/Resource_Folder_Base.zip" -d "${rcfolder}/"

# UserPlugins/ is just the loose ReaImGui binary now, no zip wrapper - a
# single-file zip wasn't earning its keep once SWS/ReaPack were dropped
# from it (see admin_scripts/copy_to_public.sh's own comment).
mkdir -p "${rcfolder}/UserPlugins"
imgui_url="https://github.com/chmaha/ReaClassical/raw/${branch}/Installers/UserPlugins/reaper_imgui-${arch}.so"
curl -L -o "${rcfolder}/UserPlugins/reaper_imgui-${arch}.so" --progress-bar "$imgui_url"

echo "Downloading the ReaClassical extension..."
sleep 1
# Testing builds are published --prerelease (see admin_scripts/publish_release.sh's
# own comment) so they never become "latest" for real stable users - which
# means releases/latest/download/ (what the regular docs/linux uses)
# would never find one either. Query the full /releases list instead
# (sorted newest-first, includes prereleases) and take the first tag.
#
# Root cause of a real, repeatedly-confirmed bug found and fixed here:
# curl was piped directly into `grep -m1`, which exits the instant it
# finds its first match. Once this repo has more than a couple releases,
# curl is very often still mid-write on a later chunk of the (much
# larger) full JSON response when grep's early exit closes the pipe -
# a genuine SIGPIPE/EPIPE, which curl reports as "curl: (23) Failure
# writing output to destination, passed X returned Y". Harmless in
# effect (grep had already captured its match before exiting, so
# $latest_tag still came out correct), but a real broken-pipe race, not
# a spurious message - confirmed via direct reproduction and isolating
# curl's own stderr for exactly this call. Fixed by capturing the full
# response into a variable first (curl runs to its own natural
# completion, nothing downstream can close early on it) and only
# grepping the already-complete string afterward - no live pipe to
# curl exists during the grep step at all. ?per_page=1 also trims the
# actual request to just the one release this needs (this endpoint's
# pagination doesn't filter prereleases, unlike /latest, so this still
# behaves identically to before).
releases_json=$(curl -sS "https://api.github.com/repos/chmaha/ReaClassical/releases?per_page=1")
latest_tag=$(echo "$releases_json" \
    | grep -m1 -oE '"tag_name":[[:space:]]*"[^"]+"' | grep -oE '"[^"]+"$' | tr -d '"')
if [ -n "$latest_tag" ]; then
    ext_output="$temp_dir/reaper_ReaClassical-${arch}.so"
    ext_url="https://github.com/chmaha/ReaClassical/releases/download/${latest_tag}/reaper_ReaClassical-${arch}.so"
    if curl -f -L -o "$ext_output" --progress-bar "$ext_url" && [ -s "$ext_output" ]; then
        # Arch-suffixed on purpose, matching the exact filename SConstruct/
        # rebuild.sh now always produce - a local rebuild or a re-run of
        # this installer must overwrite the SAME file, never coexist under
        # a different name (REAPER would load both as separate extensions
        # and silently reject every duplicate custom_action Register()
        # call from whichever loads second - a real repro this session).
        cp "$ext_output" "${rcfolder}/UserPlugins/reaper_ReaClassical-${arch}.so"
    else
        printf "\nWarning: could not download the ReaClassical extension - REAPER will start without ReaClassical loaded.\n"
        printf "Retry later via the ReaClassical website, or contact chmaha for help.\n\n"
    fi
else
    printf "\nWarning: could not find a release to download the ReaClassical extension from.\n"
    printf "REAPER will start without ReaClassical loaded - retry later or contact chmaha for help.\n\n"
fi

# Copy Effects from InstallData
echo "Copying Effects from InstallData..."
sleep 1
if [ -d "${rcfolder}/InstallData/Effects" ]; then
    mkdir -p "${rcfolder}/Effects"
    cp -r "${rcfolder}/InstallData/Effects/"* "${rcfolder}/Effects/" 2>/dev/null || \
        echo "Warning: No files found in InstallData/Effects or copy failed"
    echo "Removing InstallData folder..."
    rm -rf "${rcfolder}/InstallData"
else
    echo "Warning: InstallData/Effects directory not found"
fi

# Get the realpath of $rcfolder
rcfolder_path=$(realpath "${rcfolder}")
sleep 2
# Add the line to reaper.ini under the [REAPER] section
echo "Adding the ReaClassical theme reference to reaper.ini"
sed -i "/^\[REAPER\]/a lastthemefn5=${rcfolder_path}/ColorThemes/ReaClassical.ReaperTheme" "${rcfolder}/reaper.ini"
sleep 2
echo "Adding the ReaClassical splash to reaper.ini"
sed -i "/^\[REAPER\]/a splashimage=Scripts/chmaha Scripts/ReaClassical/reaclassical-splash.png" "${rcfolder}/reaper.ini"
sleep 2
echo "Portable ReaClassical Installation complete (TESTING BUILD)!"

cleanup
