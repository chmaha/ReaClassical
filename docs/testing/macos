#!/bin/sh

# Script to install a TESTING (pre-release) build of ReaClassical on MacOS
# Works for all architectures and OS versions that are compatible with REAPER
#
# This private repo only ever tracks ONE state - whatever's currently
# in development - so this file is the single canonical source, synced
# verbatim by admin_scripts/copy_to_public.sh into the public repo's
# main branch at docs/testing/macos (GitHub Pages only serves from
# main:/docs, and testing's own docs/ is deliberately empty - see that
# script's own comment). Pinned to the public repo's permanent "testing"
# branch (always the in-development next version) rather than main
# (always the current release) - lets testers get an always-fresh
# in-development build via the normal online-install flow, no offline-
# installer-bundle-building needed. Not linked from anywhere public -
# relayed to testers directly, same as the temporary unlock password.

# Copyright (C) 2022–2026 chmaha

rcver="testing"
branch="testing"

cleanup() {
    if [ -n "$temp_dir" ] && [ -d "$temp_dir" ]; then
        rm -rf "$temp_dir"
    fi
}

check_internet() {
    if ! ping -c 1 -W 5000 8.8.8.8 >/dev/null 2>&1; then
        printf "\nError: The ReaClassical installer requires an internet connection.\n"
        printf "Enable the connection if possible or transfer the portable install from an online machine.\n"
        printf "Exiting...\n\n"
        exit 1
    fi
}

# Trap exit signals to ensure cleanup
trap cleanup EXIT

check_internet

ver_txt="https://raw.githubusercontent.com/chmaha/ReaClassical/${branch}/tested_reaper_ver.txt"
ver=$(curl -sS "$ver_txt" | awk '/====/{getline; print}')

arch=$(uname -m)
osver=$(sw_vers -productVersion)
major=$(echo "$osver" | cut -d. -f1)
minor=$(echo "$osver" | cut -d. -f2)
dmgtype="universal"

printf "\n*** TESTING BUILD - this installs an in-development, pre-release\n"
printf "*** version of ReaClassical (currently tracking the %s branch), not the\n" "$branch"
printf "*** publicly released version. Expect bugs. ***\n\n"
sleep 2
printf "Welcome to the ReaClassical installer...\n\n"
sleep 2

default_install="$HOME/Desktop"

install_dir=$(osascript <<EOF
tell application "System Events"
    activate
    try
        set chosenFolder to choose folder ¬
            with prompt "Select the installation folder for ReaClassical:" ¬
            default location (POSIX file "$default_install")
        return POSIX path of chosenFolder
    on error number -128
        return ""
    end try
end tell
EOF
)

# User cancelled
if [ -z "$install_dir" ]; then
    echo "Installation cancelled."
    exit 1
fi

# Ensure directory exists
mkdir -p "$install_dir" || {
    echo "Failed to create installation directory: $install_dir"
    exit 1
}

printf "Selected installation folder: %s\n\n" "$install_dir"

rcfolder="${install_dir}/ReaClassical_${rcver}"

printf "Versions: REAPER %s (%s), ReaClassical %s\n\n" "$ver" "$arch" "$rcver"
sleep 2


# ==========================================================

if [ "$arch" = "i386" ]; then
    printf "\nError: ReaClassical only supports 64-bit systems.\n"
    printf "This machine (32-bit Intel) is not supported.\n\n"
    exit 1
elif [ "$major" -lt 10 ] || ([ "$major" -eq 10 ] && [ "$minor" -lt 15 ]); then
    dmgtype="x86_64"
    echo "Using x86_64 dmg file..."
else
    echo "Using universal dmg file..."
fi

date_suffix=$(date +%s | shasum -a 256 | cut -c1-5)

# Create temporary directory
temp_dir=$(mktemp -d 2>/dev/null)
if [ -z "$temp_dir" ]; then
    temp_dir="/tmp/ReaClassical_${date_suffix}"
    mkdir -p "$temp_dir"
fi

echo "Downloading REAPER $ver from reaper.fm"
sleep 2
reaper_url="https://reaper.fm/files/${ver%%.*}.x/reaper${ver//.}_$dmgtype.dmg"
curl -L -o "$temp_dir/reaper.dmg" "$reaper_url"

echo "Converting and mounting DMG..."
sleep 2
hdiutil convert -quiet "$temp_dir/reaper.dmg" -format UDTO -o "$temp_dir/reaper_temp"
hdiutil attach -quiet -nobrowse -noverify -noautoopen -mountpoint "$temp_dir/reaper_temp" "$temp_dir/reaper_temp.cdr"

echo "Downloading ReaClassical resource folder base and userplugins..."
sleep 2
res_output="$temp_dir/Resource_Folder_Base.zip"
res_url="https://github.com/chmaha/ReaClassical/raw/${branch}/Installers/Resource_Folder_Base.zip"
curl -L -o "$res_output" "$res_url"

# Check for existing folder
if [ -d "$rcfolder" ]; then
    rcfolder="${rcfolder}_${date_suffix}"
    sleep 2
    echo "Folder already exists. Adding unique suffix."
fi

echo "Extracting files into $rcfolder..."
sleep 2
unzip -q "$res_output" -d "$rcfolder/"

# UserPlugins/ is just the loose ReaImGui binary now, no zip wrapper - a
# single-file zip wasn't earning its keep once SWS/ReaPack were dropped
# from it (see admin_scripts/copy_to_public.sh's own comment).
mkdir -p "$rcfolder/UserPlugins"
imgui_url="https://github.com/chmaha/ReaClassical/raw/${branch}/Installers/UserPlugins/reaper_imgui-$arch.dylib"
curl -L -o "$rcfolder/UserPlugins/reaper_imgui-$arch.dylib" "$imgui_url"

echo "Downloading the ReaClassical extension..."
# Testing builds are published --prerelease (see admin_scripts/publish_release.sh's
# own comment) so they never become "latest" for real stable users - which
# means releases/latest/download/ (what the regular docs/macos uses)
# would never find one either. Query the full /releases list instead
# (sorted newest-first, includes prereleases) and take the first tag.
#
# Root cause of a real, repeatedly-confirmed bug found and fixed on
# docs/testing/linux (identical pattern here): curl was piped directly
# into `grep -m1`, which exits the instant it finds its first match.
# Once this repo has more than a couple releases, curl is very often
# still mid-write on a later chunk of the (much larger) full JSON
# response when grep's early exit closes the pipe - a genuine SIGPIPE/
# EPIPE, which curl reports as "curl: (23) Failure writing output to
# destination, passed X returned Y". Fixed by capturing the full
# response into a variable first (curl runs to its own natural
# completion, nothing downstream can close early on it) and only
# grepping the already-complete string afterward. ?per_page=1 also trims
# the actual request to just the one release this needs (this endpoint's
# pagination doesn't filter prereleases, unlike /latest, so this still
# behaves identically to before).
releases_json=$(curl -sS "https://api.github.com/repos/chmaha/ReaClassical/releases?per_page=1")
latest_tag=$(echo "$releases_json" \
    | grep -m1 -oE '"tag_name":[[:space:]]*"[^"]+"' | grep -oE '"[^"]+"$' | tr -d '"')
if [ -n "$latest_tag" ]; then
    ext_output="$temp_dir/reaper_ReaClassical-$arch.dylib"
    ext_url="https://github.com/chmaha/ReaClassical/releases/download/${latest_tag}/reaper_ReaClassical-$arch.dylib"
    curl -f -L -o "$ext_output" "$ext_url"
    curl_status=$?
    if [ $curl_status -eq 0 ] && [ -s "$ext_output" ]; then
        # Arch-suffixed on purpose, matching the exact filename SConstruct/
        # rebuild.sh now always produce - a local rebuild or a re-run of
        # this installer must overwrite the SAME file, never coexist under
        # a different name (REAPER would load both as separate extensions
        # and silently reject every duplicate custom_action Register()
        # call from whichever loads second - a real repro this session).
        cp "$ext_output" "$rcfolder/UserPlugins/reaper_ReaClassical-$arch.dylib"
    else
        # Surfaces the real cause instead of a generic message - a repeat
        # tester hitting GitHub's unauthenticated API rate limit (60/hr
        # per IP, real and easy to hit during a heavy testing session -
        # confirmed via this exact endpoint's own x-ratelimit-limit
        # header) looks completely different (curl exit 22, HTTP 403/429)
        # from the release's own asset simply not being fully uploaded
        # yet if this ran mid-publish (curl exit 22, HTTP 404) - both
        # previously indistinguishable from this one message alone.
        printf "\nWarning: could not download the ReaClassical extension (curl exit %s) - REAPER will start without ReaClassical loaded.\n" "$curl_status"
        printf "URL attempted: %s\n" "$ext_url"
        printf "If this keeps happening, it may be GitHub's API rate limit (resets hourly) - wait a bit and retry.\n"
        printf "Retry later via the ReaClassical website, or contact chmaha for help.\n\n"
    fi
else
    printf "\nWarning: could not find a release to download the ReaClassical extension from.\n"
    printf "REAPER will start without ReaClassical loaded - retry later or contact chmaha for help.\n\n"
fi

echo "Adding splash screen and theme references..."
sleep 2
abspath=$(cd "$rcfolder" && pwd)

sed -i '' -e "/^\[REAPER\]/a\\
lastthemefn5=${abspath}\/ColorThemes\/ReaClassical.ReaperTheme" "$rcfolder/reaper.ini"

sed -i '' -e "/^\[REAPER\]/a\\
splashimage=${abspath}\/Scripts\/chmaha Scripts\/ReaClassical\/reaclassical-splash.png" "$rcfolder/reaper.ini"

echo "Copying REAPER.app into ReaClassical folder..."
sleep 2
cp -R "$temp_dir/reaper_temp/REAPER.app" "$rcfolder/"

# Copy Effects from InstallFiles inside REAPER.app
echo "Copying Effects from InstallFiles..."
sleep 1
if [ -d "${rcfolder}/REAPER.app/Contents/InstallFiles/Effects" ]; then
    mkdir -p "${rcfolder}/Effects"
    cp -r "${rcfolder}/REAPER.app/Contents/InstallFiles/Effects/"* "${rcfolder}/Effects/" 2>/dev/null || \
        echo "Warning: No files found in InstallFiles/Effects or copy failed"
else
    echo "Warning: InstallFiles/Effects directory not found"
fi

echo "Unmounting image and cleaning up..."
sleep 2
hdiutil detach "$temp_dir/reaper_temp"

echo "Portable ReaClassical installation complete (TESTING BUILD)!"

cleanup
