#!/bin/sh

# Script to install ReaClassical on MacOS
# Works for all architectures and OS versions that are compatible with REAPER
#
# Installs the current release from https://github.com/chmaha/ReaClassical.
# Generated from the pre-release installer by release_installers.py.

