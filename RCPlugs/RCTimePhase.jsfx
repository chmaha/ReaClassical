NoIndex: true
desc:RCTime&PhaseTool (chmaha)
author: chmaha
about:
  Uses DSP from airwindows "SampleDelay" by Chris Johnson with adaptation by chmaha
  https://github.com/airwindows/airwindows/tree/master/plugins/LinuxVST/src/SampleDelay (MIT License)
  JSFX version released under a proprietary license
  (the airwindows DSP portion above remains MIT licensed, see LICENSE_MIT)

slider1:0<0,20,0.01>Horizontal Spot to Main Pair (m)
slider2:0<0,10,0.01>Differential Height of Main Pair (m)
slider3:0<0,10,0.01>Samples
slider4:0<0,1,0.01>Subsample
slider5:1<-1,1,0.01>Inv/Wet

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
freemem = 0;
pL = freemem; freemem +=16386;
pR = freemem; freemem +=16386;

@slider

A = sqrt(sqr(slider1) + sqr(slider2))/343*1000

@block
overallscale = 1.0;
overallscale /= 44100.0;
overallscale *= srate;

coarse = (A/100) * (4410.0*overallscale);
fine = slider3;
subsample = slider4;
offset = floor(coarse + fine);
(offset > 16380) ? offset = 16380;
maxtime = 16384;
phase = slider5;
dryLevel = 1.0-abs(phase);

// 4-point (3rd-order) Lagrange interpolation coefficients for the
// Subsample fraction, replacing 2-tap linear interpolation, which
// attenuates high frequencies (worst case ~-3.9dB at Nyquist when
// subsample=0.5). At subsample=0/1 these collapse to a pure
// single-tap read, matching the original code's behavior at those
// two exact values.
t = subsample;
lc0 = -t*(t-1)*(t-2)*(1/6);
lc1 =  (t+1)*(t-1)*(t-2)*0.5;
lc2 = -(t+1)*t*(t-2)*0.5;
lc3 =  (t+1)*t*(t-1)*(1/6);

@sample
inputSampleL = spl0;
inputSampleR = spl1;

drySampleL = inputSampleL;
drySampleR = inputSampleR;

(gcount < 0 || gcount > maxtime) ? gcount = maxtime;
count = gcount;
pL[count] = inputSampleL;
pR[count] = inputSampleR;
count += offset;

im1 = count-1;
(im1 < 0) ? im1 += maxtime+1;
i0 = count;
(i0 > maxtime) ? i0 -= maxtime+1;
ip1 = count+1;
(ip1 > maxtime) ? ip1 -= maxtime+1;
ip2 = count+2;
(ip2 > maxtime) ? ip2 -= maxtime+1;

inputSampleL = pL[im1]*lc0 + pL[i0]*lc1 + pL[ip1]*lc2 + pL[ip2]*lc3;
inputSampleR = pR[im1]*lc0 + pR[i0]*lc1 + pR[ip1]*lc2 + pR[ip2]*lc3;
gcount-=1;

(phase < 1.0) ? (
  inputSampleL *= phase;
  inputSampleR *= phase;
);

(dryLevel > 0.0) ? (
  inputSampleL += (drySampleL * dryLevel);
  inputSampleR += (drySampleR * dryLevel);
);

spl0 = inputSampleL;
spl1 = inputSampleR;
