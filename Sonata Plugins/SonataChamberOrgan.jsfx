y_m9 = meter_db_to_y(-9);
y_m1 = meter_db_to_y(-1);
gfx_set(0.10, 0.22, 0.14, 1);
gfx_rect(MX, y_m9, MW, MY + MH - y_m9, 1);
gfx_set(0.28, 0.24, 0.08, 1);
gfx_rect(MX, y_m1, MW, y_m9 - y_m1, 1);
gfx_set(0.30, 0.08, 0.08, 1);
gfx_rect(MX, MY, MW, y_m1 - MY, 1);

meter_db = meter_peak > 0.000001 ? 20 * log(meter_peak) / 2.302585 : -100;
fill_y = meter_db_to_y(meter_db);
meter_db > -1 ? gfx_set(1.0, 0.35, 0.30, 1) : ( meter_db > -9 ? gfx_set(1.0, 0.80, 0.25, 1) : gfx_set(0.30, 0.85, 0.50, 1) );
gfx_rect(MX, fill_y, MW, MY + MH - fill_y, 1);

hold_db = meter_hold > 0.000001 ? 20 * log(meter_hold) / 2.302585 : -100;

gfx_setfont(1, "Arial", 9*scale);
gfx_set(0.55, 0.55, 0.58, 1);
gfx_x = MX - 5*scale; gfx_y = MY - 13*scale;
gfx_drawstr("Out");

clip_latch ? gfx_set(1, 0.25, 0.25, 1) : gfx_set(0.32, 0.18, 0.18, 1);
gfx_setfont(1, "Arial", 9*scale, 'b');
gfx_measurestr("CLIP", cltw, clth);
gfx_x = MX + MW*0.5 - cltw*0.5; gfx_y = MY + MH + 4*scale;
gfx_drawstr("CLIP");

gfx_setfont(1, "Arial", 9*scale);
gfx_set(0.75, 0.75, 0.78, 1);
(meter_hold > 0.000001) ? sprintf(#holddb_txt, "%.1f", hold_db) : strcpy(#holddb_txt, "-inf");
gfx_measurestr(#holddb_txt, hdtw, hdth);
gfx_x = MX + MW*0.5 - hdtw*0.5; gfx_y = MY + MH + 4*scale + clth + 3*scale;
gfx_drawstr(#holddb_txt);

mouse_state = mouse_down;
mouse_state_r = mouse_down_r;
