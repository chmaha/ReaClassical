  );
  drag_target == 13 && mouse_down ? ( newpos = max(0, min(1, drag_start_pos + (drag_start_y - mouse_y) / (150*scale))); slider14 = taper_val(newpos, 0, 1, 0); slider_automate(slider14); );
  draw_knob(rkx, RKY, 26*scale, taper_pos(slider14, 0, 1, 0), 0.80, 0.68, 0.95,
