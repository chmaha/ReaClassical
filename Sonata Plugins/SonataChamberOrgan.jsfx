// the tuning box.
entering_tuning ? (
  ch = gfx_getchar();
  ch == 13 ? (
    match("%f", #tuning_entry, typed_tuning) ? (
      slider7 = max(372, min(495, typed_tuning)); slider_automate(slider7);
    );
    entering_tuning = 0;
  ) : ( ch == 27 ? (
    entering_tuning = 0;
  ) : ( ch == 8 ? (
    backspace_string(#tuning_entry);
  ) : ( ((ch >= 48 && ch <= 57) || ch == 46) && strlen(#tuning_entry) < 8 ? (
    sprintf(#tuning_entry, "%s%c", #tuning_entry, ch);
  ) ) ) );

  // Overlays the tuning box itself (same rect, opaque fill) instead of
  // a separate box below it -- that clashed with the Temperament
  // control directly underneath.
  EB_X = TBX; EB_Y = CTLY; EB_W = TBW; EB_H = TBH;
  entering_tuning && mouse_just_down && !just_opened_t && !hit_rect(mouse_x, mouse_y, EB_X, EB_Y, EB_W, EB_H) ? entering_tuning = 0;

  entering_tuning ? (
    gfx_set(0.05, 0.05, 0.06, 1);
    gfx_rect(EB_X, EB_Y, EB_W, EB_H, 1);
    gfx_set(0.30, 0.65, 0.75, 1);
    gfx_rect(EB_X, EB_Y, EB_W, EB_H, 0);
    gfx_setfont(1, "Arial", 12*scale);
    gfx_set(1, 1, 1, 1);
    sprintf(#eb_disp2, "%s|", #tuning_entry);
    gfx_measurestr(#eb_disp2, ebtw, ebth);
    gfx_x = EB_X + 6*scale; gfx_y = EB_Y + (EB_H - ebth)*0.5;
    gfx_drawstr(#eb_disp2);
  );
);

