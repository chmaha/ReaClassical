RBX = RCOL_X; CTLY = ry;
!reverb_popup_open && mouse_just_down && hit_rect(mouse_x, mouse_y, RBX, CTLY, RBW, RBH) ? (
  // Kicks off the same @block-driven, one-stop-per-call sweep as @init
