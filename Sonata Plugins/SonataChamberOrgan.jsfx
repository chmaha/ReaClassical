  drag_target == 10 && mouse_down ? ( newpos = max(0, min(1, drag_start_pos + (drag_start_y - mouse_y) / (150*scale))); slider11 = taper_val(newpos, 0.025, 0.150, 0); slider_automate(slider11); );
  draw_knob(rkx, RKY, 26*scale, taper_pos(slider11, 0.025, 0.150, 0), 0.55, 0.75, 0.85,
