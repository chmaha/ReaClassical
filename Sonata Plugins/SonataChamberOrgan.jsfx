  click_target = 7; click_time = time_precise();
);
drag_target == 7 && mouse_down ? ( newpos = max(0, min(1, drag_start_pos + (drag_start_y - mouse_y) / (150*scale))); slider6 = taper_val(newpos, -12, 12, 0); slider_automate(slider6); );
draw_knob(KX, MVY, 26*scale, taper_pos(slider6, -12, 12, 0), 0.85, 0.85, 0.85,
