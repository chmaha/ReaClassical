);

!mouse_down ? drag_target = -1;

MX = KX + 50*scale; MY = MVY - 28*scale; MW = 18*scale; MH = 56*scale;

function meter_db_to_y(db) ( MY + MH * (1 - max(0, min(1, (db + 60) / 60))) );

!reverb_popup_open && mouse_just_down && hit_rect(mouse_x, mouse_y, MX, MY, MW, MH) ? (
  (click_target == 8 && time_precise() - click_time < 0.3) ? (
