  gfx_measurestr("X", clxtw, clxth);
  gfx_x = CLPX + CLPW*0.5 - clxtw*0.5; gfx_y = CLPY + CLPW*0.5 - clxth*0.5;
  gfx_drawstr("X");

  RKY = PY + 100*scale; RKGAP = 96*scale; RKX0 = PX + 60*scale;

  
  rkx = RKX0;
  mouse_just_down && hit_circle(mouse_x, mouse_y, rkx, RKY, 26*scale) ? (
    (click_target == 10 && time_precise() - click_time < 0.3) ? ( slider11 = 0.075; slider_automate(slider11); ) : (
