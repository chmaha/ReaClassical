);
draw_chan_box(CHX2, CTLY, CHW2, CHH2, slider9);
ry += ROWH;

MVY = ry + 50*scale;
KX = RCOL_X + 26*scale;
!reverb_popup_open && mouse_just_down && hit_circle(mouse_x, mouse_y, KX, MVY, 26*scale) ? (
  (click_target == 7 && time_precise() - click_time < 0.3) ? ( slider6 = 0; slider_automate(slider6); ) : (
    drag_target = 7; drag_start_y = mouse_y; drag_start_pos = taper_pos(slider6, -12, 12, 0);
