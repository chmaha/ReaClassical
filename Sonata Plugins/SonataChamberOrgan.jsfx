    );
    click_target = 11; click_time = time_precise();
  );
  drag_target == 11 && mouse_down ? ( newpos = max(0, min(1, drag_start_pos + (drag_start_y - mouse_y) / (150*scale))); slider12 = taper_val(newpos, 2.0, 7.0, 0); slider_automate(slider12); );
  draw_knob(rkx, RKY, 26*scale, taper_pos(slider12, 2.0, 7.0, 0), 0.55, 0.75, 0.85,
