gfx_drawstr("Tuning (Hz)");
!reverb_popup_open && !entering_tuning && mouse_just_down && hit_rect(mouse_x, mouse_y, TBX, CTLY, TBW, TBH) ? (
  (click_target == 1 && time_precise() - click_time < 0.3) ? ( slider7 = 440; slider_automate(slider7); ) : (
    drag_target = 1; drag_start_y = mouse_y; drag_start_pos = taper_pos(slider7, 372, 495, 0);
  );
  click_target = 1; click_time = time_precise();
);
// Right-click: type an exact Hz value (real SonataOrgan.jsfx's own
