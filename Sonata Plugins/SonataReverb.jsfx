pareq1_z1_l = 0; pareq1_z2_l = 0;
pareq1_z1_r = 0; pareq1_z2_r = 0;
pareq2_z1_l = 0; pareq2_z2_l = 0;
pareq2_z1_r = 0; pareq2_z2_r = 0;

pareq1_state = 0;
pareq2_state = 0;
pareq1_g1 = 1.0;
pareq1_f1 = 1000.0;
pareq2_g1 = 1.0;
pareq2_f1 = 1000.0;

model_bass_z1_l = 0; model_bass_z2_l = 0;
model_bass_z1_r = 0; model_bass_z2_r = 0;
model_bass_state = 0;
model_bass_g1 = 1.0;
model_bass_f1 = 120.0;

g0 = 0.75;
g1 = 0.371;
d0 = 0;
d1 = 0;

out_meter_l = 0;
out_meter_r = 0;

@slider

@block

ipdel = slider1 * 0.001;
xover = slider2;
rtlow = slider3*slider4;
rtmid = slider4;
fdamp = slider5;
eq1_freq = slider6;
eq1_gain = slider7;
eq2_freq = slider8;
eq2_gain = slider9;
opmix = slider10;
mod_type = slider11;
mod_amount = slider12 * 0.01;

mod_type == 1 ? (
  model_bass_freq = 120;
  model_bass_gain = 4.0;
  model_xover_offset = 1.0;
  model_damp_offset = 1.1;
  sat_drive = 2.0;
  tank_sat_drive = 1.18;
  diff1_coeff = 0.70;

  er_level = 0.65;
  tank_mod_depth_base = 0.0004;

) : mod_type == 2 ? (
  model_bass_freq = 120;
  model_bass_gain = 5.0;
  model_xover_offset = 0.95;
  model_damp_offset = 0.9;
  sat_drive = 1.4;
  tank_sat_drive = 1.08;
  diff1_coeff = 0.75;

  er_level = 0.6;
  er_feedback = 0.2;

  hf_split_coeff = exp(-2 * $pi * 3000 / srate);
  tank_mod_depth_base = 0.0004;

) : (
  model_bass_freq = 120;
  model_bass_gain = 0;
  model_xover_offset = 1.0;
  model_damp_offset = 1.0;
  er_level = 0.55;
  sat_drive = 1.0;
  tank_sat_drive = 1.0;
  diff1_coeff = 0.60;
  tank_mod_depth_base = 0.0004;
);

diff1_0_c =  diff1_coeff;
diff1_1_c = -diff1_coeff;
diff1_2_c =  diff1_coeff;
diff1_3_c = -diff1_coeff;
diff1_4_c =  diff1_coeff;
diff1_5_c = -diff1_coeff;
diff1_6_c =  diff1_coeff;
diff1_7_c = -diff1_coeff;

sat_makeup = 1.0 / sat_drive;
tank_sat_makeup = 1.0 / tank_sat_drive;

eq1_freq_final = eq1_freq;
eq1_gain_final = eq1_gain;
eq2_freq_final = eq2_freq;
eq2_gain_final = eq2_gain;

model_bass_g0 = pow(10.0, 0.05 * model_bass_gain);
model_bass_f0 = model_bass_freq;

xover_final = xover * model_xover_offset;
fdamp_final = fdamp * model_damp_offset;

mod_type == 1 ? (
  mod_rate = 0.31;
  mod_depth_base = 0.00045;
  mod_rate2 = 0.41;
  mod_rate3 = 0;
  mod_mix = 0.30;
  mod_mix3 = 0;
  drift_rate = 0.08;
  drift_mix = 0.30;
  d2mod_rate = 0;
  d2mod_depth_base = 0;
) : mod_type == 2 ? (
  mod_rate = 0.21;
  mod_depth_base = 0.0015;
  mod_rate2 = 0.34;
  mod_rate3 = 0.13;
  mod_mix = 0.18;
  mod_mix3 = 0.12;
  drift_rate = 0.06;
  drift_mix = 0.15;
  d2mod_rate = 0.15;
  d2mod_depth_base = 0.0002;
) : (
  mod_rate = 0;
  mod_depth_base = 0;
  mod_rate2 = 0;
  mod_rate3 = 0;
  mod_mix = 0;
  mod_mix3 = 0;
  drift_rate = 0;
  drift_mix = 0;
  d2mod_rate = 0;
  d2mod_depth_base = 0;
);

mod_depth = mod_depth_base * mod_amount;
mod_depth_samples = mod_depth * srate;

mod_inc = 2 * $pi * mod_rate / srate;
mod_inc2 = 2 * $pi * mod_rate2 / srate;
mod_inc3 = mod_type == 2 ? 2 * $pi * mod_rate3 / srate : 0;
mod_drift_inc = 2 * $pi * drift_rate / srate;
d2mod_inc = mod_type == 2 ? 2 * $pi * d2mod_rate / srate : 0;
d2mod_depth_samples = d2mod_depth_base * mod_amount * srate;

tank_mod_depth_samples = tank_mod_depth_base * mod_amount * srate;
tank_mod_inc_0 = 2 * $pi * tank_mod_rate_0 / srate;
tank_mod_inc_1 = 2 * $pi * tank_mod_rate_1 / srate;
tank_mod_inc_2 = 2 * $pi * tank_mod_rate_2 / srate;
tank_mod_inc_3 = 2 * $pi * tank_mod_rate_3 / srate;
tank_mod_inc_4 = 2 * $pi * tank_mod_rate_4 / srate;
tank_mod_inc_5 = 2 * $pi * tank_mod_rate_5 / srate;
tank_mod_inc_6 = 2 * $pi * tank_mod_rate_6 / srate;
tank_mod_inc_7 = 2 * $pi * tank_mod_rate_7 / srate;

mod_type == 1 ? (
  shimmer_rate = 0.05;
  shimmer_depth = 0.06;
) : mod_type == 2 ? (
  shimmer_rate = 0.07;
  shimmer_depth = 0.09;
) : (
  shimmer_rate = 0;
  shimmer_depth = 0;
);
shimmer_inc = 2 * $pi * shimmer_rate / srate;
shimmer_smooth_coeff = exp(-2 * $pi * 3 / srate);
shimmer_smooth = 0;

meter_release = exp(-1.0 / (0.15 * srate));

k = floor(ipdel * srate + 0.5);
k = max(0, min(k, vdelay0_size - 1));
vdelay0_del = k;
vdelay1_del = k;

wlo = 6.2832 * xover_final / srate;
(fdamp_final > 0.49 * srate) ? (
  chi = 2;
) : (
  chi = 1 - cos(6.2832 * fdamp_final / srate);
);

t0 = (1 - opmix) * (1 + opmix);
t1 = 0.7 * opmix * (2 - opmix) / sqrt(rtmid);
d0 = (t0 - g0) / samplesblock;
d1 = (t1 - g1) / samplesblock;

pareq1_g0 = pow(10.0, 0.05 * eq1_gain_final);
pareq1_f0 = eq1_freq_final;
pareq2_g0 = pow(10.0, 0.05 * eq2_gain_final);
pareq2_f0 = eq2_freq_final;

filt1_0.set_filt_params(tdelay_0, rtmid, rtlow, wlo, 0.5 * rtmid, chi);
filt1_1.set_filt_params(tdelay_1, rtmid, rtlow, wlo, 0.5 * rtmid, chi);
filt1_2.set_filt_params(tdelay_2, rtmid, rtlow, wlo, 0.5 * rtmid, chi);
filt1_3.set_filt_params(tdelay_3, rtmid, rtlow, wlo, 0.5 * rtmid, chi);
filt1_4.set_filt_params(tdelay_4, rtmid, rtlow, wlo, 0.5 * rtmid, chi);
filt1_5.set_filt_params(tdelay_5, rtmid, rtlow, wlo, 0.5 * rtmid, chi);
filt1_6.set_filt_params(tdelay_6, rtmid, rtlow, wlo, 0.5 * rtmid, chi);
filt1_7.set_filt_params(tdelay_7, rtmid, rtlow, wlo, 0.5 * rtmid, chi);

function pareq_calcpar(g, f)
local(b, c1, c2, gg, ff)
(
  ff = f * $pi / srate;
  b = 2 * ff / sqrt(g);
  gg = 0.5 * (g - 1);
  c1 = -cos(2 * ff);
  c2 = (1 - b) / (1 + b);
  this.c1 = c1;
  this.c2 = c2;
  this.gg = gg;
);

pareq1_upd = 0;
(pareq1_g0 != pareq1_g1) ? (
  pareq1_upd = 1;
  (pareq1_g0 > 2 * pareq1_g1) ? pareq1_g1 *= 2
  : (pareq1_g1 > 2 * pareq1_g0) ? pareq1_g1 /= 2
  : pareq1_g1 = pareq1_g0;
);
(pareq1_f0 != pareq1_f1) ? (
  pareq1_upd = 1;
  (pareq1_f0 > 2 * pareq1_f1) ? pareq1_f1 *= 2
  : (pareq1_f1 > 2 * pareq1_f0) ? pareq1_f1 /= 2
  : pareq1_f1 = pareq1_f0;
);
(pareq1_upd) ? (
  pareq1.pareq_calcpar(pareq1_g1, pareq1_f1);
  pareq1_state = 1;
) : (
  (abs(pareq1_g1 - 1) < 0.001) ? (
    pareq1_state = 0;
    pareq1_z1_l = 0; pareq1_z2_l = 0;
    pareq1_z1_r = 0; pareq1_z2_r = 0;
  ) : pareq1_state = 1;
);

pareq2_upd = 0;
(pareq2_g0 != pareq2_g1) ? (
  pareq2_upd = 1;
  (pareq2_g0 > 2 * pareq2_g1) ? pareq2_g1 *= 2
  : (pareq2_g1 > 2 * pareq2_g0) ? pareq2_g1 /= 2
  : pareq2_g1 = pareq2_g0;
);
(pareq2_f0 != pareq2_f1) ? (
  pareq2_upd = 1;
  (pareq2_f0 > 2 * pareq2_f1) ? pareq2_f1 *= 2
  : (pareq2_f1 > 2 * pareq2_f0) ? pareq2_f1 /= 2
  : pareq2_f1 = pareq2_f0;
);
(pareq2_upd) ? (
  pareq2.pareq_calcpar(pareq2_g1, pareq2_f1);
  pareq2_state = 1;
) : (
  (abs(pareq2_g1 - 1) < 0.001) ? (
    pareq2_state = 0;
    pareq2_z1_l = 0; pareq2_z2_l = 0;
    pareq2_z1_r = 0; pareq2_z2_r = 0;
  ) : pareq2_state = 1;
);

model_bass_upd = 0;
(model_bass_g0 != model_bass_g1) ? (
  model_bass_upd = 1;
  (model_bass_g0 > 2 * model_bass_g1) ? model_bass_g1 *= 2
  : (model_bass_g1 > 2 * model_bass_g0) ? model_bass_g1 /= 2
  : model_bass_g1 = model_bass_g0;
);
(model_bass_f0 != model_bass_f1) ? (
  model_bass_upd = 1;
  (model_bass_f0 > 2 * model_bass_f1) ? model_bass_f1 *= 2
  : (model_bass_f1 > 2 * model_bass_f0) ? model_bass_f1 /= 2
  : model_bass_f1 = model_bass_f0;
);
(model_bass_upd) ? (
  model_bass.pareq_calcpar(model_bass_g1, model_bass_f1);
  model_bass_state = 1;
) : (
  (abs(model_bass_g1 - 1) < 0.001) ? (
    model_bass_state = 0;
    model_bass_z1_l = 0; model_bass_z2_l = 0;
    model_bass_z1_r = 0; model_bass_z2_r = 0;
  ) : model_bass_state = 1;
);

@sample

mod_type > 0 ? (
  mod_phase_0 += mod_inc;
  mod_phase_0 >= 2 * $pi ? mod_phase_0 -= 2 * $pi;

  mod_phase_1 += mod_inc;
  mod_phase_1 >= 2 * $pi ? mod_phase_1 -= 2 * $pi;

  mod_phase_2 += mod_inc;
  mod_phase_2 >= 2 * $pi ? mod_phase_2 -= 2 * $pi;

  mod_phase_3 += mod_inc;
  mod_phase_3 >= 2 * $pi ? mod_phase_3 -= 2 * $pi;

  mod_phase_4 += mod_inc2;
  mod_phase_4 >= 2 * $pi ? mod_phase_4 -= 2 * $pi;

  mod_phase_5 += mod_inc2;
  mod_phase_5 >= 2 * $pi ? mod_phase_5 -= 2 * $pi;

  mod_phase_6 += mod_inc2;
  mod_phase_6 >= 2 * $pi ? mod_phase_6 -= 2 * $pi;

  mod_phase_7 += mod_inc2;
  mod_phase_7 >= 2 * $pi ? mod_phase_7 -= 2 * $pi;

  mod_type == 2 ? (
    mod_phase_t0 += mod_inc3;
    mod_phase_t0 >= 2 * $pi ? mod_phase_t0 -= 2 * $pi;

    mod_phase_t1 += mod_inc3;
    mod_phase_t1 >= 2 * $pi ? mod_phase_t1 -= 2 * $pi;

    mod_phase_t2 += mod_inc3;
    mod_phase_t2 >= 2 * $pi ? mod_phase_t2 -= 2 * $pi;

    mod_phase_t3 += mod_inc3;
    mod_phase_t3 >= 2 * $pi ? mod_phase_t3 -= 2 * $pi;

    mod_phase_t4 += mod_inc3;
    mod_phase_t4 >= 2 * $pi ? mod_phase_t4 -= 2 * $pi;

    mod_phase_t5 += mod_inc3;
    mod_phase_t5 >= 2 * $pi ? mod_phase_t5 -= 2 * $pi;

    mod_phase_t6 += mod_inc3;
    mod_phase_t6 >= 2 * $pi ? mod_phase_t6 -= 2 * $pi;

    mod_phase_t7 += mod_inc3;
    mod_phase_t7 >= 2 * $pi ? mod_phase_t7 -= 2 * $pi;
  );

  mod_phase_d0 += mod_drift_inc;
  mod_phase_d0 >= 2 * $pi ? mod_phase_d0 -= 2 * $pi;

  mod_phase_d1 += mod_drift_inc;
  mod_phase_d1 >= 2 * $pi ? mod_phase_d1 -= 2 * $pi;

  mod_phase_d2 += mod_drift_inc;
  mod_phase_d2 >= 2 * $pi ? mod_phase_d2 -= 2 * $pi;

  mod_phase_d3 += mod_drift_inc;
  mod_phase_d3 >= 2 * $pi ? mod_phase_d3 -= 2 * $pi;

  mod_phase_d4 += mod_drift_inc;
  mod_phase_d4 >= 2 * $pi ? mod_phase_d4 -= 2 * $pi;

  mod_phase_d5 += mod_drift_inc;
  mod_phase_d5 >= 2 * $pi ? mod_phase_d5 -= 2 * $pi;

  mod_phase_d6 += mod_drift_inc;
  mod_phase_d6 >= 2 * $pi ? mod_phase_d6 -= 2 * $pi;

  mod_phase_d7 += mod_drift_inc;
  mod_phase_d7 >= 2 * $pi ? mod_phase_d7 -= 2 * $pi;

  mod_type == 2 ? (
    d2mod_phase_0 += d2mod_inc;
    d2mod_phase_0 >= 2 * $pi ? d2mod_phase_0 -= 2 * $pi;

    d2mod_phase_1 += d2mod_inc;
    d2mod_phase_1 >= 2 * $pi ? d2mod_phase_1 -= 2 * $pi;

    d2mod_phase_2 += d2mod_inc;
    d2mod_phase_2 >= 2 * $pi ? d2mod_phase_2 -= 2 * $pi;

    d2mod_phase_3 += d2mod_inc;
    d2mod_phase_3 >= 2 * $pi ? d2mod_phase_3 -= 2 * $pi;
  );

  mod_type == 1 ? (
    mod_0 = mod_depth_samples * (sin(mod_phase_0) + mod_mix * sin(mod_phase_4) + drift_mix * sin(mod_phase_d0));
    mod_1 = mod_depth_samples * (sin(mod_phase_1) + mod_mix * sin(mod_phase_5) + drift_mix * sin(mod_phase_d1));
    mod_2 = mod_depth_samples * (sin(mod_phase_2) + mod_mix * sin(mod_phase_6) + drift_mix * sin(mod_phase_d2));
    mod_3 = mod_depth_samples * (sin(mod_phase_3) + mod_mix * sin(mod_phase_7) + drift_mix * sin(mod_phase_d3));
    mod_4 = mod_depth_samples * (sin(mod_phase_4) + mod_mix * sin(mod_phase_0) + drift_mix * sin(mod_phase_d4));
    mod_5 = mod_depth_samples * (sin(mod_phase_5) + mod_mix * sin(mod_phase_1) + drift_mix * sin(mod_phase_d5));
    mod_6 = mod_depth_samples * (sin(mod_phase_6) + mod_mix * sin(mod_phase_2) + drift_mix * sin(mod_phase_d6));
    mod_7 = mod_depth_samples * (sin(mod_phase_7) + mod_mix * sin(mod_phase_3) + drift_mix * sin(mod_phase_d7));
  ) : (
    mod_0 = mod_depth_samples * (sin(mod_phase_0) + mod_mix * sin(mod_phase_4) + mod_mix3 * sin(mod_phase_t0) + drift_mix * sin(mod_phase_d0));
    mod_1 = mod_depth_samples * (sin(mod_phase_1) + mod_mix * sin(mod_phase_5) + mod_mix3 * sin(mod_phase_t1) + drift_mix * sin(mod_phase_d1));
    mod_2 = mod_depth_samples * (sin(mod_phase_2) + mod_mix * sin(mod_phase_6) + mod_mix3 * sin(mod_phase_t2) + drift_mix * sin(mod_phase_d2));
    mod_3 = mod_depth_samples * (sin(mod_phase_3) + mod_mix * sin(mod_phase_7) + mod_mix3 * sin(mod_phase_t3) + drift_mix * sin(mod_phase_d3));
    mod_4 = mod_depth_samples * (sin(mod_phase_4) + mod_mix * sin(mod_phase_0) + mod_mix3 * sin(mod_phase_t4) + drift_mix * sin(mod_phase_d4));
    mod_5 = mod_depth_samples * (sin(mod_phase_5) + mod_mix * sin(mod_phase_1) + mod_mix3 * sin(mod_phase_t5) + drift_mix * sin(mod_phase_d5));
    mod_6 = mod_depth_samples * (sin(mod_phase_6) + mod_mix * sin(mod_phase_2) + mod_mix3 * sin(mod_phase_t6) + drift_mix * sin(mod_phase_d6));
    mod_7 = mod_depth_samples * (sin(mod_phase_7) + mod_mix * sin(mod_phase_3) + mod_mix3 * sin(mod_phase_t7) + drift_mix * sin(mod_phase_d7));
  );

  mod_type == 2 ? (
    d2mod_0 = -0.6 * d2mod_depth_samples * sin(d2mod_phase_0);
    d2mod_1 = d2mod_depth_samples * sin(d2mod_phase_0);
    d2mod_2 = d2mod_depth_samples * sin(d2mod_phase_1);
    d2mod_3 = -0.6 * d2mod_depth_samples * sin(d2mod_phase_1);
    d2mod_4 = -0.6 * d2mod_depth_samples * sin(d2mod_phase_2);
    d2mod_5 = d2mod_depth_samples * sin(d2mod_phase_2);
    d2mod_6 = d2mod_depth_samples * sin(d2mod_phase_3);
    d2mod_7 = -0.6 * d2mod_depth_samples * sin(d2mod_phase_3);
  ) : (
    d2mod_0 = d2mod_1 = d2mod_2 = d2mod_3 = 0;
    d2mod_4 = d2mod_5 = d2mod_6 = d2mod_7 = 0;
  );

  shimmer_raw = sin(shimmer_phase);
  shimmer_phase += shimmer_inc;
  shimmer_phase >= 2 * $pi ? shimmer_phase -= 2 * $pi;
  shimmer_smooth += (1 - shimmer_smooth_coeff) * (shimmer_raw - shimmer_smooth);

) : (
  mod_0 = mod_1 = mod_2 = mod_3 = mod_4 = mod_5 = mod_6 = mod_7 = 0;
  d2mod_0 = d2mod_1 = d2mod_2 = d2mod_3 = 0;
  d2mod_4 = d2mod_5 = d2mod_6 = d2mod_7 = 0;
  shimmer_smooth = 0;
);







tank_mod_phase_0 += tank_mod_inc_0;
tank_mod_phase_0 >= 2 * $pi ? tank_mod_phase_0 -= 2 * $pi;

tank_mod_phase_1 += tank_mod_inc_1;
tank_mod_phase_1 >= 2 * $pi ? tank_mod_phase_1 -= 2 * $pi;

tank_mod_phase_2 += tank_mod_inc_2;
tank_mod_phase_2 >= 2 * $pi ? tank_mod_phase_2 -= 2 * $pi;

tank_mod_phase_3 += tank_mod_inc_3;
tank_mod_phase_3 >= 2 * $pi ? tank_mod_phase_3 -= 2 * $pi;

tank_mod_phase_4 += tank_mod_inc_4;
tank_mod_phase_4 >= 2 * $pi ? tank_mod_phase_4 -= 2 * $pi;

tank_mod_phase_5 += tank_mod_inc_5;
tank_mod_phase_5 >= 2 * $pi ? tank_mod_phase_5 -= 2 * $pi;

tank_mod_phase_6 += tank_mod_inc_6;
tank_mod_phase_6 >= 2 * $pi ? tank_mod_phase_6 -= 2 * $pi;

tank_mod_phase_7 += tank_mod_inc_7;
tank_mod_phase_7 >= 2 * $pi ? tank_mod_phase_7 -= 2 * $pi;

tank_mod_0 = tank_mod_depth_samples * sin(tank_mod_phase_0);
tank_mod_1 = tank_mod_depth_samples * sin(tank_mod_phase_1);
tank_mod_2 = tank_mod_depth_samples * sin(tank_mod_phase_2);
tank_mod_3 = tank_mod_depth_samples * sin(tank_mod_phase_3);
tank_mod_4 = tank_mod_depth_samples * sin(tank_mod_phase_4);
tank_mod_5 = tank_mod_depth_samples * sin(tank_mod_phase_5);
tank_mod_6 = tank_mod_depth_samples * sin(tank_mod_phase_6);
tank_mod_7 = tank_mod_depth_samples * sin(tank_mod_phase_7);

vdelay0_line[vdelay0_iw] = spl0;
vdelay0_iw += 1;
(vdelay0_iw >= vdelay0_size) ? vdelay0_iw = 0;

vdelay1_line[vdelay1_iw] = spl1;
vdelay1_iw += 1;
(vdelay1_iw >= vdelay1_size) ? vdelay1_iw = 0;

vdelay0_rd = vdelay0_iw - vdelay0_del;
(vdelay0_rd < 0) ? vdelay0_rd += vdelay0_size;

vdelay1_rd = vdelay1_iw - vdelay1_del;
(vdelay1_rd < 0) ? vdelay1_rd += vdelay1_size;






mod_type == 1 ? (
  er_mk7_line_l[er_mk7_write] = vdelay0_line[vdelay0_rd];
  er_mk7_line_r[er_mk7_write] = vdelay1_line[vdelay1_rd];

  er_mix_l = 0;
  vn_i = 0;
  loop(vn_count_l,
    vn_idx = er_mk7_write - vn_pos_l[vn_i];
    vn_idx < 0 ? vn_idx += er_mk7_size;
    er_mix_l += vn_sign_l[vn_i] * vn_gain_l[vn_i] * er_mk7_line_l[vn_idx];
    vn_i += 1;
  );

  er_mix_r = 0;
  vn_i = 0;
  loop(vn_count_r,
    vn_idx = er_mk7_write - vn_pos_r[vn_i];
    vn_idx < 0 ? vn_idx += er_mk7_size;
    er_mix_r += vn_sign_r[vn_i] * vn_gain_r[vn_i] * er_mk7_line_r[vn_idx];
    vn_i += 1;
  );

  z_l = er_mk7_diff_l[er_mk7_diff_i];
  z_r = er_mk7_diff_r[er_mk7_diff_i];
  er_mk7_diff_l[er_mk7_diff_i] = er_mix_l + 0.3 * z_l;
  er_mk7_diff_r[er_mk7_diff_i] = er_mix_r + 0.3 * z_r;
  er_diffused_l = z_l - 0.3 * er_mk7_diff_l[er_mk7_diff_i];
  er_diffused_r = z_r - 0.3 * er_mk7_diff_r[er_mk7_diff_i];
  er_mk7_diff_i += 1;
  er_mk7_diff_i >= er_mk7_diff_size ? er_mk7_diff_i = 0;

  z2_l = er_mk7_diff2_l[er_mk7_diff2_i];
  z2_r = er_mk7_diff2_r[er_mk7_diff2_i];
  er_mk7_diff2_l[er_mk7_diff2_i] = er_diffused_l + 0.4 * z2_l;
  er_mk7_diff2_r[er_mk7_diff2_i] = er_diffused_r + 0.4 * z2_r;
  er_diffused2_l = z2_l - 0.4 * er_mk7_diff2_l[er_mk7_diff2_i];
  er_diffused2_r = z2_r - 0.4 * er_mk7_diff2_r[er_mk7_diff2_i];
  er_mk7_diff2_i += 1;
  er_mk7_diff2_i >= er_mk7_diff2_size ? er_mk7_diff2_i = 0;

  er_mk7_write += 1;
  er_mk7_write >= er_mk7_size ? er_mk7_write = 0;

  er_inject_l = er_diffused2_l * er_level;
  er_inject_r = er_diffused2_r * er_level;

) : mod_type == 2 ? (
  er_lexis_line_l[er_lexis_write] = vdelay0_line[vdelay0_rd];
  er_lexis_line_r[er_lexis_write] = vdelay1_line[vdelay1_rd];

  er_mix_l = 0;
  vn_i = 0;
  loop(vn_count_l,
    vn_idx = er_lexis_write - vn_pos_l[vn_i];
    vn_idx < 0 ? vn_idx += er_lexis_size;
    er_mix_l += vn_sign_l[vn_i] * vn_gain_l[vn_i] * er_lexis_line_l[vn_idx];
    vn_i += 1;
  );

  er_mix_r = 0;
  vn_i = 0;
  loop(vn_count_r,
    vn_idx = er_lexis_write - vn_pos_r[vn_i];
    vn_idx < 0 ? vn_idx += er_lexis_size;
    er_mix_r += vn_sign_r[vn_i] * vn_gain_r[vn_i] * er_lexis_line_r[vn_idx];
    vn_i += 1;
  );

  er_lexis_line_l[er_lexis_write] += er_mix_l * er_feedback;
  er_lexis_line_r[er_lexis_write] += er_mix_r * er_feedback;

  z_l = er_lexis_diff_l[er_lexis_diff_i];
  z_r = er_lexis_diff_r[er_lexis_diff_i];
  er_lexis_diff_l[er_lexis_diff_i] = er_mix_l + 0.35 * z_l;
  er_lexis_diff_r[er_lexis_diff_i] = er_mix_r + 0.35 * z_r;
  er_diffused_l = z_l - 0.35 * er_lexis_diff_l[er_lexis_diff_i];
  er_diffused_r = z_r - 0.35 * er_lexis_diff_r[er_lexis_diff_i];
  er_lexis_diff_i += 1;
  er_lexis_diff_i >= er_lexis_diff_size ? er_lexis_diff_i = 0;

  er_lexis_write += 1;
  er_lexis_write >= er_lexis_size ? er_lexis_write = 0;

  er_inject_l = er_diffused_l * er_level;
  er_inject_r = er_diffused_r * er_level;

) : (
  er_zr1_line_l[er_zr1_write] = vdelay0_line[vdelay0_rd];
  er_zr1_line_r[er_zr1_write] = vdelay1_line[vdelay1_rd];

  er_mix_l = 0;
  vn_i = 0;
  loop(vn_count_l,
    vn_idx = er_zr1_write - vn_pos_l[vn_i];
    vn_idx < 0 ? vn_idx += er_zr1_size;
    er_mix_l += vn_sign_l[vn_i] * vn_gain_l[vn_i] * er_zr1_line_l[vn_idx];
    vn_i += 1;
  );

  er_mix_r = 0;
  vn_i = 0;
  loop(vn_count_r,
    vn_idx = er_zr1_write - vn_pos_r[vn_i];
    vn_idx < 0 ? vn_idx += er_zr1_size;
    er_mix_r += vn_sign_r[vn_i] * vn_gain_r[vn_i] * er_zr1_line_r[vn_idx];
    vn_i += 1;
  );

  z_l = er_zr1_diff_l[er_zr1_diff_i];
  z_r = er_zr1_diff_r[er_zr1_diff_i];
  er_zr1_diff_l[er_zr1_diff_i] = er_mix_l + 0.3 * z_l;
  er_zr1_diff_r[er_zr1_diff_i] = er_mix_r + 0.3 * z_r;
  er_diffused_l = z_l - 0.3 * er_zr1_diff_l[er_zr1_diff_i];
  er_diffused_r = z_r - 0.3 * er_zr1_diff_r[er_zr1_diff_i];
  er_zr1_diff_i += 1;
  er_zr1_diff_i >= er_zr1_diff_size ? er_zr1_diff_i = 0;

  z2_l = er_zr1_diff2_l[er_zr1_diff2_i];
  z2_r = er_zr1_diff2_r[er_zr1_diff2_i];
  er_zr1_diff2_l[er_zr1_diff2_i] = er_diffused_l + 0.4 * z2_l;
  er_zr1_diff2_r[er_zr1_diff2_i] = er_diffused_r + 0.4 * z2_r;
  er_diffused2_l = z2_l - 0.4 * er_zr1_diff2_l[er_zr1_diff2_i];
  er_diffused2_r = z2_r - 0.4 * er_zr1_diff2_r[er_zr1_diff2_i];
  er_zr1_diff2_i += 1;
  er_zr1_diff2_i >= er_zr1_diff2_size ? er_zr1_diff2_i = 0;

  er_zr1_write += 1;
  er_zr1_write >= er_zr1_size ? er_zr1_write = 0;

  er_inject_l = er_diffused2_l * er_level;
  er_inject_r = er_diffused2_r * er_level;
);






vd0 = er_inject_l;
vd1 = er_inject_r;

t = 0.3 * vd0;

read_pos = diff1_0_i - diff1_0_base - mod_0;
read_pos < 0 ? read_pos += diff1_0_size;
read_idx = floor(read_pos);
read_frac = read_pos - read_idx;
read_idx2 = read_idx + 1;
read_idx2 >= diff1_0_size ? read_idx2 -= diff1_0_size;
z0 = diff1_0_line[read_idx] * (1 - read_frac) + diff1_0_line[read_idx2] * read_frac;
trd_pos = delay_0_i - delay_0_base - tank_mod_0;
trd_pos < 0 ? trd_pos += delay_0_size;
trd_idx = floor(trd_pos);
trd_frac = trd_pos - trd_idx;
trd_idx2 = trd_idx + 1;
trd_idx2 >= delay_0_size ? trd_idx2 -= delay_0_size;
inp0 = delay_0_line[trd_idx] * (1 - trd_frac) + delay_0_line[trd_idx2] * trd_frac + t;
inp0 -= diff1_0_c * z0;
diff1_0_line[diff1_0_i] = inp0;
diff1_0_i += 1;
(diff1_0_i >= diff1_0_size) ? diff1_0_i = 0;
x0 = z0 + diff1_0_c * inp0;

