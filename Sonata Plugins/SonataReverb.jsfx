fv4 = g * x4;
filt1_4_slo += filt1_4.wlo * (fv4 - filt1_4_slo) + 1*10^-10;
fv4 += filt1_4.glo * filt1_4_slo;
filt1_4_shi += filt1_4.whi * (fv4 - filt1_4_shi);
fv4 = filt1_4.gmf * filt1_4_shi;
mod_type > 0 ? (
  tw4 = fv4 * tank_sat_drive;
  (tw4 > 1) ? tw4 = 1;
  (tw4 < -1) ? tw4 = -1;
  fv4 = (tw4 - tw4*tw4*tw4/3) * tank_sat_makeup;
);
delay_4_line[delay_4_i] = fv4;
delay_4_i += 1;
(delay_4_i >= delay_4_size) ? delay_4_i = 0;

fv5 = g * x5;
filt1_5_slo += filt1_5.wlo * (fv5 - filt1_5_slo) + 1*10^-10;
fv5 += filt1_5.glo * filt1_5_slo;
filt1_5_shi += filt1_5.whi * (fv5 - filt1_5_shi);
fv5 = filt1_5.gmf * filt1_5_shi;
mod_type > 0 ? (
  tw5 = fv5 * tank_sat_drive;
  (tw5 > 1) ? tw5 = 1;
  (tw5 < -1) ? tw5 = -1;
  fv5 = (tw5 - tw5*tw5*tw5/3) * tank_sat_makeup;
);
delay_5_line[delay_5_i] = fv5;
delay_5_i += 1;
(delay_5_i >= delay_5_size) ? delay_5_i = 0;

fv6 = g * x6;
filt1_6_slo += filt1_6.wlo * (fv6 - filt1_6_slo) + 1*10^-10;
fv6 += filt1_6.glo * filt1_6_slo;
filt1_6_shi += filt1_6.whi * (fv6 - filt1_6_shi);
fv6 = filt1_6.gmf * filt1_6_shi;
mod_type > 0 ? (
  tw6 = fv6 * tank_sat_drive;
  (tw6 > 1) ? tw6 = 1;
  (tw6 < -1) ? tw6 = -1;
  fv6 = (tw6 - tw6*tw6*tw6/3) * tank_sat_makeup;
);
delay_6_line[delay_6_i] = fv6;
delay_6_i += 1;
(delay_6_i >= delay_6_size) ? delay_6_i = 0;

fv7 = g * x7;
filt1_7_slo += filt1_7.wlo * (fv7 - filt1_7_slo) + 1*10^-10;
fv7 += filt1_7.glo * filt1_7_slo;
filt1_7_shi += filt1_7.whi * (fv7 - filt1_7_shi);
fv7 = filt1_7.gmf * filt1_7_shi;
mod_type > 0 ? (
  tw7 = fv7 * tank_sat_drive;
  (tw7 > 1) ? tw7 = 1;
  (tw7 < -1) ? tw7 = -1;
  fv7 = (tw7 - tw7*tw7*tw7/3) * tank_sat_makeup;
);
delay_7_line[delay_7_i] = fv7;
delay_7_i += 1;
(delay_7_i >= delay_7_size) ? delay_7_i = 0;

(pareq1_state != 0) ? (
  c1 = pareq1.c1; c2 = pareq1.c2; gg = pareq1.gg;
  z1 = pareq1_z1_l; z2 = pareq1_z2_l;
  xx = out_l;
  yy = xx - c2 * z2;
  out_l = xx - gg * (z2 + c2 * yy - xx);
  yy -= c1 * z1;
  z2 = z1 + c1 * yy;
  z1 = yy + 1*10^-20;
  pareq1_z1_l = z1; pareq1_z2_l = z2;
);

(pareq1_state != 0) ? (
  c1 = pareq1.c1; c2 = pareq1.c2; gg = pareq1.gg;
  z1 = pareq1_z1_r; z2 = pareq1_z2_r;
  xx = out_r;
  yy = xx - c2 * z2;
  out_r = xx - gg * (z2 + c2 * yy - xx);
  yy -= c1 * z1;
  z2 = z1 + c1 * yy;
  z1 = yy + 1*10^-20;
  pareq1_z1_r = z1; pareq1_z2_r = z2;
);

(pareq2_state != 0) ? (
  c1 = pareq2.c1; c2 = pareq2.c2; gg = pareq2.gg;
  z1 = pareq2_z1_l; z2 = pareq2_z2_l;
  xx = out_l;
  yy = xx - c2 * z2;
  out_l = xx - gg * (z2 + c2 * yy - xx);
  yy -= c1 * z1;
  z2 = z1 + c1 * yy;
  z1 = yy + 1*10^-20;
  pareq2_z1_l = z1; pareq2_z2_l = z2;
);

(pareq2_state != 0) ? (
  c1 = pareq2.c1; c2 = pareq2.c2; gg = pareq2.gg;
  z1 = pareq2_z1_r; z2 = pareq2_z2_r;
  xx = out_r;
  yy = xx - c2 * z2;
  out_r = xx - gg * (z2 + c2 * yy - xx);
  yy -= c1 * z1;
  z2 = z1 + c1 * yy;
  z1 = yy + 1*10^-20;
  pareq2_z1_r = z1; pareq2_z2_r = z2;
);

(model_bass_state != 0) ? (
  c1 = model_bass.c1; c2 = model_bass.c2; gg = model_bass.gg;
  z1 = model_bass_z1_l; z2 = model_bass_z2_l;
  xx = out_l;
  yy = xx - c2 * z2;
  out_l = xx - gg * (z2 + c2 * yy - xx);
  yy -= c1 * z1;
  z2 = z1 + c1 * yy;
  z1 = yy + 1*10^-20;
  model_bass_z1_l = z1; model_bass_z2_l = z2;
);

(model_bass_state != 0) ? (
  c1 = model_bass.c1; c2 = model_bass.c2; gg = model_bass.gg;
  z1 = model_bass_z1_r; z2 = model_bass_z2_r;
  xx = out_r;
  yy = xx - c2 * z2;
  out_r = xx - gg * (z2 + c2 * yy - xx);
  yy -= c1 * z1;
  z2 = z1 + c1 * yy;
  z1 = yy + 1*10^-20;
  model_bass_z1_r = z1; model_bass_z2_r = z2;
);

g0 += d0;

mod_type > 0 ? (
  w_l = out_l * sat_drive;
  (w_l > 1) ? w_l = 1;
  (w_l < -1) ? w_l = -1;
  out_l = (w_l - w_l * w_l * w_l / 3) * sat_makeup;

  w_r = out_r * sat_drive;
  (w_r > 1) ? w_r = 1;
  (w_r < -1) ? w_r = -1;
  out_r = (w_r - w_r * w_r * w_r / 3) * sat_makeup;

  shimmer = shimmer_depth * shimmer_smooth;
  shimmer_diff = 0.5 * (out_l - out_r);
  out_l += shimmer * shimmer_diff;
  out_r -= shimmer * shimmer_diff;

  spl0 = out_l + g0 * spl0;
  spl1 = out_r + g0 * spl1;
) : (
  spl0 = out_l + g0 * spl0;
  spl1 = out_r + g0 * spl1;
);

out_meter_l = max(abs(spl0), out_meter_l * meter_release);
out_meter_r = max(abs(spl1), out_meter_r * meter_release);

@gfx 620 520

function draw_knob(x, y, radius, value, min_val, max_val, label, unit, disabled, col_r, col_g, col_b)
local(pos, ang0, ang1, ang, i, tx, ty, kr, kg, kb)
(
  pos = (value - min_val) / (max_val - min_val);
  disabled ? ( kr = 0.35; kg = 0.35; kb = 0.38; ) : ( kr = col_r; kg = col_g; kb = col_b; );

  ang0 = -2.35619;
  ang1 =  2.35619;

  gfx_set(0.05, 0.05, 0.06, 1);
  gfx_circle(x, y, radius + 2*scale, 1, 1);
  gfx_set(kr*0.55, kg*0.55, kb*0.55, 1);
  gfx_circle(x, y, radius, 1, 1);
  gfx_set(kr, kg, kb, 1);
  gfx_circle(x, y, radius*0.72, 1, 1);
  gfx_set(1, 1, 1, 0.18);
  gfx_circle(x - radius*0.28, y - radius*0.28, radius*0.42, 1, 1);

  i = 0;
  loop(9,
    ang = ang0 + (ang1 - ang0) * (i / 8);
    gfx_set(0.85, 0.85, 0.85, 0.7);
    gfx_line(x + sin(ang)*radius*0.82, y - cos(ang)*radius*0.82,
             x + sin(ang)*radius*0.98, y - cos(ang)*radius*0.98);
    i += 1;
  );

  ang = ang0 + (ang1 - ang0) * pos;
  gfx_set(0.05, 0.05, 0.05, 1);
  gfx_line(x, y, x + sin(ang)*radius*0.85, y - cos(ang)*radius*0.85);

  (label == "BASS") ?
    sprintf(#kval, "%.2f%s", value, unit) :
    sprintf(#kval, "%.1f%s", value, unit);
  sprintf(#kmin, "%.5g%s", min_val, unit);
  sprintf(#kmax, "%.5g%s", max_val, unit);

  gfx_setfont(5, "Arial", 12*scale);
  disabled ? gfx_set(0.5, 0.5, 0.5, 1) : gfx_set(0.85, 0.85, 0.85, 1);
  gfx_measurestr(#kval, tx, ty);
  gfx_x = x - tx*0.5; gfx_y = y - radius - 16*scale;
  gfx_drawstr(#kval);

  gfx_setfont(6, "Arial", 10*scale);
  gfx_set(0.55, 0.55, 0.58, 1);
  gfx_x = x - radius - 4*scale; gfx_y = y + radius + 4*scale;
  gfx_drawstr(#kmin);
  gfx_measurestr(#kmax, tx, ty);
  gfx_x = x + radius - tx + 4*scale; gfx_y = y + radius + 4*scale;
  gfx_drawstr(#kmax);

  gfx_setfont(5, "Arial", 12*scale);
  disabled ? gfx_set(0.4, 0.4, 0.4, 1) : gfx_set(0.8, 0.8, 0.82, 1);
  gfx_measurestr(label, tx, ty);
  gfx_x = x - tx*0.5; gfx_y = y + radius + 18*scale;
  gfx_drawstr(label);
);

function draw_slider(x, y, w, h, value, min_val, max_val, label, unit)
local(norm_val, fill_h, val_str)
(
  norm_val = (value - min_val) / (max_val - min_val);
  fill_h = h * norm_val;
  gfx_set(0.2, 0.2, 0.25);
  gfx_rect(x, y, w, h, 1);
  gfx_set(accent_r, accent_g, accent_b);
  gfx_rect(x + 2 * scale, y + h - fill_h - 2 * scale, w - 4 * scale, fill_h, 1);
  gfx_set(0.4, 0.4, 0.45);
  gfx_rect(x, y, w, h, 0);
  gfx_set(0.8, 0.8, 0.8);
  gfx_measurestr(label, str_w, str_h);
  gfx_x = x + w * 0.5 - str_w * 0.5;
  gfx_y = y + h + 8 * scale;
  gfx_drawstr(label);
  gfx_set(0.6, 0.6, 0.6);
  sprintf(val_str, "%.1f%s", value, unit);
  gfx_measurestr(val_str, str_w, str_h);
  gfx_x = x + w * 0.5 - str_w * 0.5;
  gfx_y = y + h + 24 * scale;
  gfx_drawstr(val_str);
);

function draw_glass_seg(bx, by, bw, bh, cr, cg, cb)
local(gap)
(
  gap = max(1, scale);
  gfx_set(0.04, 0.04, 0.05);
  gfx_rect(bx - gap, by - gap, bw + 2*gap, bh + 2*gap, 1);
  gfx_set(cr*0.6, cg*0.6, cb*0.6);
  gfx_rect(bx, by, bw, bh, 1);
  gfx_set(cr, cg, cb);
  gfx_rect(bx + gap, by + gap, bw - 2*gap, bh*0.5, 1);
  gfx_set(1, 1, 1, 0.18);
  gfx_rect(bx + gap, by + gap, bw - 2*gap, bh*0.32, 1);
  gfx_set(1, 1, 1, 0.3);
  gfx_rect(bx, by, bw, gap, 1);
  gfx_set(0, 0, 0, 0.3);
  gfx_rect(bx, by + bh - gap, bw, gap, 1);
  gfx_set(0.03, 0.03, 0.04);
  gfx_rect(bx - gap, by - gap, bw + 2*gap, bh + 2*gap, 0);
);

function draw_mod_selector(x, y, w, h, value)
local(box_w, label, mcr, mcg, mcb)
(
  gfx_set(0.2, 0.2, 0.25);
  gfx_rect(x, y, w, h, 1);
  gfx_set(0.4, 0.4, 0.45);
  gfx_rect(x, y, w, h, 0);
  box_w = (w - 8 * scale) / 3;
  value == 0 ? ( mcr = 0.55; mcg = 0.72; mcb = 0.95; ) : ( mcr = 0.15; mcg = 0.15; mcb = 0.18; );
  draw_glass_seg(x + 2 * scale, y + 2 * scale, box_w, h - 4 * scale, mcr, mcg, mcb);
  value == 1 ? ( mcr = 0.95; mcg = 0.55; mcb = 0.58; ) : ( mcr = 0.15; mcg = 0.15; mcb = 0.18; );
  draw_glass_seg(x + box_w + 4 * scale, y + 2 * scale, box_w, h - 4 * scale, mcr, mcg, mcb);
  value == 2 ? ( mcr = 0.55; mcg = 0.88; mcb = 0.62; ) : ( mcr = 0.15; mcg = 0.15; mcb = 0.18; );
  draw_glass_seg(x + 2 * box_w + 6 * scale, y + 2 * scale, box_w, h - 4 * scale, mcr, mcg, mcb);
  gfx_setfont(4, "Arial", 9 * scale);
  value == 0 ? gfx_set(0, 0, 0) : gfx_set(0.8, 0.8, 0.8);
  gfx_measurestr("ZR1", str_w, str_h);
  gfx_x = x + box_w * 0.5 - str_w * 0.5;
  gfx_y = y + h * 0.5 - str_h * 0.5;
  gfx_drawstr("ZR1");
  value == 1 ? gfx_set(0, 0, 0) : gfx_set(0.8, 0.8, 0.8);
  gfx_measurestr("MK VII", str_w, str_h);
  gfx_x = x + box_w * 1.5 + 4 * scale - str_w * 0.5;
  gfx_y = y + h * 0.5 - str_h * 0.5;
  gfx_drawstr("MK VII");
  value == 2 ? gfx_set(0, 0, 0) : gfx_set(0.8, 0.8, 0.8);
  gfx_measurestr("LEXIS", str_w, str_h);
  gfx_x = x + box_w * 2.5 + 6 * scale - str_w * 0.5;
  gfx_y = y + h * 0.5 - str_h * 0.5;
  gfx_drawstr("LEXIS");
  gfx_set(0.8, 0.8, 0.8);
  gfx_setfont(4, "Arial", 11 * scale);
  gfx_measurestr("MOD TYPE", str_w, str_h);
);

function hue_rotate(r, g, b, deg)
global(hr_r, hr_g, hr_b)
local(rad, c, s, w, a, bc)
(
  rad = deg * 0.0174533;
  c = cos(rad); s = sin(rad);
  w = (1 - c) / 3;
  a = w - 0.5773503 * s;
  bc = w + 0.5773503 * s;
  hr_r = (c + w) * r + a * g + bc * b;
  hr_g = bc * r + (c + w) * g + a * b;
  hr_b = a * r + bc * g + (c + w) * b;
  hr_r = min(max(hr_r, 0), 1);
  hr_g = min(max(hr_g, 0), 1);
  hr_b = min(max(hr_b, 0), 1);
);

function point_in_circle(px, py, cx, cy, radius)
(
  sqrt((px - cx)^2 + (py - cy)^2) <= radius;
);

function point_in_rect(px, py, rx, ry, rw, rh)
(
  px >= rx && px <= rx + rw && py >= ry && py <= ry + rh;
);

mod_type == 1 ? (
  accent_r = 0.95; accent_g = 0.55; accent_b = 0.58;
) : mod_type == 2 ? (
  accent_r = 0.55; accent_g = 0.88; accent_b = 0.62;
) : (
  accent_r = 0.55; accent_g = 0.72; accent_b = 0.95;
);

gfx_set(0.13, 0.13, 0.15);
gfx_rect(0, 0, gfx_w, gfx_h);
gfx_gradrect(0, 0, gfx_w, gfx_h, 0.13, 0.13, 0.15, 0, 0.07, 0.08, 0.1, 0, 1);

gfx_set(0.9, 0.9, 0.9);
gfx_setfont(1, "Arial", 20 * scale, 'b');
gfx_x = 20 * scale;
gfx_y = 20 * scale;
gfx_set(accent_r, accent_g, accent_b);
gfx_drawstr("SONATA REVERB");

gfx_set(0.6, 0.6, 0.6);
gfx_setfont(2, "Arial", 11 * scale);
gfx_x = 20 * scale;
gfx_y = 50 * scale;
gfx_drawstr("by chmaha");

gfx_setfont(3, "Arial", 14 * scale, 'b');

gfx_set(0.7, 0.7, 0.7);
gfx_x = 60 * scale;
gfx_y = 90 * scale;
gfx_drawstr("INPUT");

gfx_x = 172 * scale;
gfx_y = 90 * scale;
gfx_drawstr("REVERB");

gfx_x = 512 * scale;
gfx_y = 165 * scale;
gfx_drawstr("OUTPUT");

gfx_x = 60 * scale;
gfx_y = 240 * scale;
gfx_drawstr("TONE");

gfx_x = 60 * scale;
gfx_y = 390 * scale;
gfx_drawstr("MODEL");

gfx_setfont(4, "Arial", 11 * scale);

knob_r = 28 * scale;
knob_y1 = 150 * scale;
knob_y2 = 300 * scale;

hue_rotate(accent_r, accent_g, accent_b, -60);
draw_knob(80 * scale, knob_y1, knob_r, slider1, 20, 100, "DELAY", "ms", 0, hr_r, hr_g, hr_b);

hue_rotate(accent_r, accent_g, accent_b, -45);
draw_knob(200 * scale, knob_y1, knob_r, slider4, 1, 8, "RT MID", "s", 0, hr_r, hr_g, hr_b);
hue_rotate(accent_r, accent_g, accent_b, -30);
draw_knob(310 * scale, knob_y1, knob_r, slider2, 50, 1000, "XOVER", "Hz", 0, hr_r, hr_g, hr_b);
hue_rotate(accent_r, accent_g, accent_b, -15);
draw_knob(420 * scale, knob_y1, knob_r, slider3, 0.5, 2, "BASS", "x", 0, hr_r, hr_g, hr_b);

hue_rotate(accent_r, accent_g, accent_b, 0);
draw_knob(80 * scale, knob_y2, knob_r, slider5, 1500, 24000, "DAMP", "Hz", 0, hr_r, hr_g, hr_b);
hue_rotate(accent_r, accent_g, accent_b, 15);
draw_knob(200 * scale, knob_y2, knob_r, slider6, 40, 2500, "EQ1 F", "Hz", 0, hr_r, hr_g, hr_b);
draw_slider(260 * scale, knob_y2 - 40 * scale, 22 * scale, 80 * scale, slider7, -15, 15, "EQ1 G", "dB");
hue_rotate(accent_r, accent_g, accent_b, 30);
draw_knob(350 * scale, knob_y2, knob_r, slider8, 160, 10000, "EQ2 F", "Hz", 0, hr_r, hr_g, hr_b);
draw_slider(410 * scale, knob_y2 - 40 * scale, 22 * scale, 80 * scale, slider9, -15, 15, "EQ2 G", "dB");

hue_rotate(accent_r, accent_g, accent_b, 45);
draw_knob(540 * scale, 225 * scale, knob_r, slider10 * 100, 0, 100, "DRY/WET", "%", 0, hr_r, hr_g, hr_b);

MTR_MIN_DB = -48;
function mtr_frac(lin)
local(db)
(
  lin < 0.00001 ? 0 : (
    db = max(MTR_MIN_DB, min(0, 20*log10(lin)));
    (db - MTR_MIN_DB) / (0 - MTR_MIN_DB);
  );
);

meter_x = 584 * scale;
meter_w = 6 * scale;
meter_h = 100 * scale;
meter_y = 175 * scale;
mtr_l = mtr_frac(out_meter_l);
mtr_r = mtr_frac(out_meter_r);
gfx_set(0.18, 0.18, 0.22);
gfx_rect(meter_x, meter_y, meter_w, meter_h, 1);
gfx_set(0.4, 0.4, 0.45);
gfx_rect(meter_x, meter_y, meter_w, meter_h, 0);
mtr_l > 0.001 ? (
  gfx_set(accent_r * 0.7, accent_g * 0.7, accent_b * 0.7);
  gfx_rect(meter_x + 1 * scale, meter_y + meter_h * (1 - mtr_l), meter_w - 2 * scale, meter_h * mtr_l, 1);
);
gfx_set(0.18, 0.18, 0.22);
gfx_rect(meter_x + meter_w + 4 * scale, meter_y, meter_w, meter_h, 1);
gfx_set(0.4, 0.4, 0.45);
gfx_rect(meter_x + meter_w + 4 * scale, meter_y, meter_w, meter_h, 0);
mtr_r > 0.001 ? (
  gfx_set(accent_r * 0.7, accent_g * 0.7, accent_b * 0.7);
  gfx_rect(meter_x + meter_w + 5 * scale, meter_y + meter_h * (1 - mtr_r), meter_w - 2 * scale, meter_h * mtr_r, 1);
);

draw_mod_selector(60 * scale, 425 * scale, 180 * scale, 30 * scale, slider11);
hue_rotate(accent_r, accent_g, accent_b, 60);
draw_knob(320 * scale, 440 * scale, knob_r, slider12, 0, 100, "MOD AMT", "%", slider11 == 0, hr_r, hr_g, hr_b);

mouse_wheel ? (
  wheel_slider = 0;
  point_in_circle(mouse_x, mouse_y, 80 * scale, knob_y1, knob_r) ? wheel_slider = 1 :
  point_in_circle(mouse_x, mouse_y, 200 * scale, knob_y1, knob_r) ? wheel_slider = 4 :
  point_in_circle(mouse_x, mouse_y, 310 * scale, knob_y1, knob_r) ? wheel_slider = 2 :
  point_in_circle(mouse_x, mouse_y, 420 * scale, knob_y1, knob_r) ? wheel_slider = 3 :
  point_in_circle(mouse_x, mouse_y, 80 * scale, knob_y2, knob_r) ? wheel_slider = 5 :
  point_in_circle(mouse_x, mouse_y, 200 * scale, knob_y2, knob_r) ? wheel_slider = 6 :
  point_in_rect(mouse_x, mouse_y, 260 * scale, knob_y2 - 40 * scale, 22 * scale, 80 * scale) ? wheel_slider = 7 :
  point_in_circle(mouse_x, mouse_y, 350 * scale, knob_y2, knob_r) ? wheel_slider = 8 :
  point_in_rect(mouse_x, mouse_y, 410 * scale, knob_y2 - 40 * scale, 22 * scale, 80 * scale) ? wheel_slider = 9 :
  point_in_circle(mouse_x, mouse_y, 540 * scale, 225 * scale, knob_r) ? wheel_slider = 10 :
  point_in_rect(mouse_x, mouse_y, 60 * scale, 425 * scale, 180 * scale, 30 * scale) ? wheel_slider = 11 :
  (slider11 != 0 && point_in_circle(mouse_x, mouse_y, 320 * scale, 440 * scale, knob_r)) ? wheel_slider = 12;

  wheel_slider > 0 ? (
    wheel_delta = mouse_wheel / 120;
    wheel_slider == 1 ? slider1 = max(20, min(100, slider1 + wheel_delta * 1)) :
    wheel_slider == 2 ? slider2 = max(50, min(1000, slider2 + wheel_delta * 25)) :
    wheel_slider == 3 ? slider3 = max(0.5, min(2, slider3 + wheel_delta * 0.05)) :
    wheel_slider == 4 ? slider4 = max(1, min(8, slider4 + wheel_delta * 0.1)) :
    wheel_slider == 5 ? slider5 = max(1500, min(24000, slider5 + wheel_delta * 500)) :
    wheel_slider == 6 ? slider6 = max(40, min(2500, slider6 + wheel_delta * 50)) :
    wheel_slider == 7 ? slider7 = max(-15, min(15, slider7 + wheel_delta * 0.5)) :
    wheel_slider == 8 ? slider8 = max(160, min(10000, slider8 + wheel_delta * 200)) :
    wheel_slider == 9 ? slider9 = max(-15, min(15, slider9 + wheel_delta * 0.5)) :
    wheel_slider == 10 ? slider10 = max(0, min(1, slider10 + wheel_delta * 0.01)) :
    wheel_slider == 11 ? slider11 = max(0, min(2, slider11 + (wheel_delta > 0 ? 1 : -1))) :
    wheel_slider == 12 ? slider12 = max(0, min(100, slider12 + wheel_delta * 5));
  );
  mouse_wheel = 0;
);

mouse_cap ? (
  !mouse_state ? (
    (time_precise() - last_click_time < 0.3) && last_clicked_slider > 0 ? (
      last_clicked_slider == 1 ? slider1 = 40 :
      last_clicked_slider == 2 ? slider2 = 200 :
      last_clicked_slider == 3 ? slider3 = 1.5 :
      last_clicked_slider == 4 ? slider4 = 2.0 :
      last_clicked_slider == 5 ? slider5 = 6000 :
      last_clicked_slider == 6 ? slider6 = 160 :
      last_clicked_slider == 7 ? slider7 = 0 :
      last_clicked_slider == 8 ? slider8 = 2500 :
      last_clicked_slider == 9 ? slider9 = 0 :
      last_clicked_slider == 10 ? slider10 = 0.5 :
      last_clicked_slider == 11 ? slider11 = 0 :
      last_clicked_slider == 12 ? slider12 = 50;
      last_clicked_slider = 0;
    ) : (
      point_in_circle(mouse_x, mouse_y, 80 * scale, knob_y1, knob_r) ? (active_slider = 1; drag_start_y = mouse_y; drag_start_val = slider1;) :
      point_in_circle(mouse_x, mouse_y, 200 * scale, knob_y1, knob_r) ? (active_slider = 4; drag_start_y = mouse_y; drag_start_val = slider4;) :
      point_in_circle(mouse_x, mouse_y, 310 * scale, knob_y1, knob_r) ? (active_slider = 2; drag_start_y = mouse_y; drag_start_val = slider2;) :
      point_in_circle(mouse_x, mouse_y, 420 * scale, knob_y1, knob_r) ? (active_slider = 3; drag_start_y = mouse_y; drag_start_val = slider3;) :
      point_in_circle(mouse_x, mouse_y, 80 * scale, knob_y2, knob_r) ? (active_slider = 5; drag_start_y = mouse_y; drag_start_val = slider5;) :
      point_in_circle(mouse_x, mouse_y, 200 * scale, knob_y2, knob_r) ? (active_slider = 6; drag_start_y = mouse_y; drag_start_val = slider6;) :
      point_in_rect(mouse_x, mouse_y, 260 * scale, knob_y2 - 40 * scale, 22 * scale, 80 * scale) ? (active_slider = 7; drag_start_y = mouse_y; drag_start_val = slider7;) :
      point_in_circle(mouse_x, mouse_y, 350 * scale, knob_y2, knob_r) ? (active_slider = 8; drag_start_y = mouse_y; drag_start_val = slider8;) :
      point_in_rect(mouse_x, mouse_y, 410 * scale, knob_y2 - 40 * scale, 22 * scale, 80 * scale) ? (active_slider = 9; drag_start_y = mouse_y; drag_start_val = slider9;) :
      point_in_circle(mouse_x, mouse_y, 540 * scale, 225 * scale, knob_r) ? (active_slider = 10; drag_start_y = mouse_y; drag_start_val = slider10;) :
      point_in_rect(mouse_x, mouse_y, 60 * scale, 425 * scale, 180 * scale, 30 * scale) ? (
        rel_x = mouse_x - 80 * scale;
        box_w = (180 * scale - 8 * scale) / 3;
        rel_x < box_w + 2 * scale ? slider11 = 0 :
        rel_x < 2 * box_w + 4 * scale ? slider11 = 1 :
        slider11 = 2;
        active_slider = 11;
      ) :
      (slider11 != 0 && point_in_circle(mouse_x, mouse_y, 320 * scale, 440 * scale, knob_r)) ? (active_slider = 12; drag_start_y = mouse_y; drag_start_val = slider12;);
      last_clicked_slider = active_slider;
      last_click_time = time_precise();
    );
    mouse_state = 1;
  );
  active_slider > 0 && active_slider != 11 ? (
    delta = (drag_start_y - mouse_y) * 0.6;
    active_slider == 1 ? slider1 = max(20, min(100, drag_start_val + delta)) :
    active_slider == 2 ? slider2 = max(50, min(1000, drag_start_val + delta * 3)) :
    active_slider == 3 ? slider3 = max(0.5, min(2, drag_start_val + delta * 0.005)) :
    active_slider == 4 ? slider4 = max(1, min(8, drag_start_val + delta * 0.02)) :
    active_slider == 5 ? slider5 = max(1500, min(24000, drag_start_val + delta * 50)) :
    active_slider == 6 ? slider6 = max(40, min(2500, drag_start_val + delta * 5)) :
    active_slider == 7 ? slider7 = max(-15, min(15, drag_start_val + delta * 0.1)) :
    active_slider == 8 ? slider8 = max(160, min(10000, drag_start_val + delta * 20)) :
    active_slider == 9 ? slider9 = max(-15, min(15, drag_start_val + delta * 0.1)) :
    active_slider == 10 ? slider10 = max(0, min(1, drag_start_val + delta * 0.003)) :
    active_slider == 12 ? slider12 = max(0, min(100, drag_start_val + delta));
  );
) : (
  mouse_state = 0;
  active_slider = 0;
);
