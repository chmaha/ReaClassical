diff1_7_i += 1;
(diff1_7_i >= diff1_7_size) ? diff1_7_i = 0;
x7 = z7 + diff1_7_c * inp7;

t = x0 - x1; x0 += x1; x1 = t;
t = x2 - x3; x2 += x3; x3 = t;
t = x4 - x5; x4 += x5; x5 = t;
t = x6 - x7; x6 += x7; x7 = t;
t = x0 - x2; x0 += x2; x2 = t;
t = x1 - x3; x1 += x3; x3 = t;
t = x4 - x6; x4 += x6; x6 = t;
t = x5 - x7; x5 += x7; x7 = t;
t = x0 - x4; x0 += x4; x4 = t;
t = x1 - x5; x1 += x5; x5 = t;
t = x2 - x6; x2 += x6; x6 = t;
t = x3 - x7; x3 += x7; x7 = t;

g1 += d1;
out_l = g1 * (x1 + x2);
out_r = g1 * (x1 - x2);

mod_type > 0 ? (
  d2_rpos = d2_0_i - diff2_0_base + d2mod_0;
  d2_rpos < 0 ? d2_rpos += diff2_0_size;
