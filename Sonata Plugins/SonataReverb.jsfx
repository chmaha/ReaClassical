diff1_7_base = floor(tdiff1_7 * srate + 0.5);

tdiff2_0 = 7.3*10^-3;
tdiff2_1 = 9.7*10^-3;
tdiff2_2 = 12.1*10^-3;
tdiff2_3 = 14.9*10^-3;
tdiff2_4 = 17.6*10^-3;
tdiff2_5 = 20.3*10^-3;
tdiff2_6 = 23.8*10^-3;
tdiff2_7 = 27.4*10^-3;

max_mod_samples2 = floor(0.003 * srate);

diff2_0_base = floor(tdiff2_0 * srate + 0.5);
diff2_0_size = diff2_0_base + max_mod_samples2;
diff2_0_line = alloc(diff2_0_size);
