er_zr1_diff2_r = alloc(er_zr1_diff2_size);
er_zr1_diff2_i = 0;

er_lexis_size = floor(0.220 * srate);
er_lexis_line_l = alloc(er_lexis_size);
er_lexis_line_r = alloc(er_lexis_size);
er_lexis_write = 0;









VN_TEND = 0.06;
VN_RHO0 = 300;
VN_RHO1 = 400;
VN_TAU = 0.038;
VN_MAXTAPS = 64;

vn_seed = 987654321;

function vn_rand01()
(
  vn_seed = (vn_seed * 48271) % 2147483647;
  vn_seed / 2147483647;
);

vn_pos_l  = alloc(VN_MAXTAPS);
vn_sign_l = alloc(VN_MAXTAPS);
vn_gain_l = alloc(VN_MAXTAPS);
vn_pos_r  = alloc(VN_MAXTAPS);
vn_sign_r = alloc(VN_MAXTAPS);
vn_gain_r = alloc(VN_MAXTAPS);

function vn_generate(pos_arr, sign_arr, gain_arr)
local(t, rho, grid_w, jitter, n, i, sumsq, norm)
(
  t = 0; n = 0;
  while (t < VN_TEND && n < VN_MAXTAPS) (
    rho = VN_RHO0 * pow(VN_RHO1 / VN_RHO0, t / VN_TEND);
    grid_w = 1 / rho;
    jitter = vn_rand01() * grid_w;
    pos_arr[n] = floor((t + jitter) * srate);
    sign_arr[n] = (vn_rand01() < 0.5) ? -1 : 1;
    gain_arr[n] = exp(-t / VN_TAU) / sqrt(rho);
    n += 1;
    t += grid_w;
  );

  
  
  
  
  
  
  sumsq = 0;
  i = 0;
  loop(n, sumsq += gain_arr[i] * gain_arr[i]; i += 1;);
  norm = sumsq > 0 ? 1 / sqrt(sumsq) : 1;
  i = 0;
  loop(n, gain_arr[i] *= norm; i += 1;);

  n;
);

vn_count_l = vn_generate(vn_pos_l, vn_sign_l, vn_gain_l);
vn_count_r = vn_generate(vn_pos_r, vn_sign_r, vn_gain_r);

