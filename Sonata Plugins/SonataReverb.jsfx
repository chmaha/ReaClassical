diff2_1_line = alloc(diff2_1_size);
diff2_1_c = -0.625;

diff2_2_base = floor(tdiff2_2 * srate + 0.5);
diff2_2_size = diff2_2_base + max_mod_samples2;
diff2_2_line = alloc(diff2_2_size);
diff2_2_c = 0.625;

diff2_3_base = floor(tdiff2_3 * srate + 0.5);
diff2_3_size = diff2_3_base + max_mod_samples2;
diff2_3_line = alloc(diff2_3_size);
diff2_3_c = -0.625;

diff2_4_base = floor(tdiff2_4 * srate + 0.5);
diff2_4_size = diff2_4_base + max_mod_samples2;
diff2_4_line = alloc(diff2_4_size);
diff2_4_c = 0.625;

