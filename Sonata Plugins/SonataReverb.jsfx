diff3_l1_size = floor(0.0043 * srate);
diff3_l1_line = alloc(diff3_l1_size);
diff3_l1_i = 0;

diff3_r0_size = floor(0.0037 * srate);
diff3_r0_line = alloc(diff3_r0_size);
diff3_r0_i = 0;

diff3_r1_size = floor(0.0049 * srate);
diff3_r1_line = alloc(diff3_r1_size);
diff3_r1_i = 0;

delay_0_base = floor(tdelay_0 * srate + 0.5) - diff1_0_base;
delay_0_size = delay_0_base + max_tank_mod_samples;
delay_0_line = alloc(delay_0_size);
delay_0_i = 0;

delay_1_base = floor(tdelay_1 * srate + 0.5) - diff1_1_base;
delay_1_size = delay_1_base + max_tank_mod_samples;
